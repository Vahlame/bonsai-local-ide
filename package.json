{
  "name": "bonsai-local-ide",
  "version": "1.7.0",
  "private": true,
  "description": "Bonsai Local IDE: agente de desarrollo local con llama-server para Windows 10 y 11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vahlame/bonsai-local-ide.git"
  },
  "bugs": {
    "url": "https://github.com/Vahlame/bonsai-local-ide/issues"
  },
  "homepage": "https://github.com/Vahlame/bonsai-local-ide#readme",
  "scripts": {
    "benchmark:coder": "node chat/evaluar/coder.mjs",
    "benchmark:engine": "node scripts/benchmark-local-engine.mjs",
    "benchmark:rtx4060": "powershell -ExecutionPolicy Bypass -File scripts/benchmark-rtx4060-matrix.ps1",
    "benchmark:quality": "node scripts/bench-model-quality.mjs",
    "benchmark:sampling": "node scripts/bench-model-quality.mjs --sampling --repeat 2",
    "benchmark:project": "node scripts/bench-project.mjs",
    "models:hub": "node scripts/hub.mjs",
    "models:lab": "node scripts/model-lab.mjs",
    "models:tune": "node scripts/model-tune.mjs",
    "models:quality": "node scripts/bench-model-quality.mjs",
    "probe:context": "powershell -ExecutionPolicy Bypass -File scripts/probe-rtx4060-context.ps1",
    "build:rtx4060": "powershell -ExecutionPolicy Bypass -File scripts/build-rtx4060-optimized.ps1",
    "test": "node scripts/run-tests.mjs",
    "test:gpu": "node scripts/run-tests.mjs gpu",
    "test:gpu-exclusiva": "node scripts/run-tests.mjs gpu-exclusiva",
    "test:navegador": "node scripts/run-tests.mjs navegador",
    "test:todo": "node scripts/run-tests.mjs todo",
    "test:listar": "node scripts/run-tests.mjs --listar",
    "docs:links": "node scripts/check-doc-links.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
