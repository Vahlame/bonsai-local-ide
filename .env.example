# Variables de entorno de Bonsai Local IDE (opcionales).
# Cópialas a tu entorno o a un .env que cargue tu shell. El IDE no lee .env por
# sí mismo: no hay carga automática para que un secreto no entre en el proyecto.
# Las rutas absolutas deben ir entre comillas si contienen espacios.

# --- Estado y datos ---------------------------------------------------------
# Carpeta de estado (sesiones, ajustes, undo, trazas). Por defecto: chat/
BONSAI_STATE=
# Carpeta de artefactos de salida. Por defecto: salida/
BONSAI_SALIDA=
# Carpeta de modelos GGUF. Por defecto: models/
BONSAI_MODELS_DIR=
# Registro y catálogo del Hub.
BONSAI_HUB_CATALOG=
BONSAI_CURATED_CATALOG=
# Solo para pruebas locales del Hub: permite descargar de 127.0.0.1/LAN.
BONSAI_HUB_ALLOW_PRIVATE=0

# --- Agente -----------------------------------------------------------------
# legacy | small-local-coder | optimized
BONSAI_AGENT_PROFILE=
# JSON con opciones del coder (contextTokens, etc.).
BONSAI_CODER_OPTIONS=
BONSAI_CODER_CONFIG=
# Permite que el modelo escriba el dialecto XML antiguo como fallback.
BONSAI_LEGACY_TOOL_PARSER=0
# Número de herramientas en paralelo (entero).
BONSAI_PARALLEL_TOOLS=1
# Latido SSE en milisegundos.
BONSAI_LATIDO_MS=15000
# Volcado crudo de stream para depurar.
BONSAI_RAW_STREAM=0

# --- Red --------------------------------------------------------------------
# Endpoint de SearXNG local; el agente solo lo usa para buscar.
BONSAI_SEARXNG_URL=
# Solo para pruebas: permite leer_web contra loopback/LAN.
BONSAI_WEB_ALLOW_LOCAL=0
# Token de la UI cuando se expone en LAN con --unsafe-lan (mínimo 16 caracteres).
BONSAI_UI_TOKEN=

# --- Navegador y MCP --------------------------------------------------------
# Ruta al navegador de Playwright (opcional).
BONSAI_BROWSER=
# Ruta al módulo de Playwright si no está en chat/node_modules.
BONSAI_PLAYWRIGHT_MODULE=
# Ruta a node_modules para el MCP.
BONSAI_MCP_NODE_MODULES=
# Ruta a tree-sitter/TypeScript LSP si usas instalaciones propias.
BONSAI_TREE_SITTER_MODULE=
BONSAI_TYPESCRIPT_MODULE=
BONSAI_TS_LSP_CLI=
# ConPTY opcional; sin node-pty se usa la shell por tuberías.
BONSAI_PTY=0

# --- Herramientas de sistema ------------------------------------------------
# Prefijo de logs de llama-server y log de arranque.
BONSAI_LLAMA_LOG_PREFIX=
BONSAI_LOG_ARRANQUE=
# Script OCR opcional.
BONSAI_OCR_SCRIPT=

# --- Solo pruebas -----------------------------------------------------------
# No las uses en producción.
BONSAI_PRUEBA=0
BONSAI_UI_EVIDENCE=0
BONSAI_UI_EVIDENCE_DIR=
BONSAI_TEST_OUTPUT=
