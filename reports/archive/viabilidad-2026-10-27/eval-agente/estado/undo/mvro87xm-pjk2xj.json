{"tipo":"texto","rel":"contador.html","antes":null,"despues":"<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Contador</title>\n  <style>\n    body { font-family: sans-serif; text-align: center; padding-top: 40vh; }\n    #numero { font-size: 48px; }\n  </style>\n</head>\n<body>\n  <div id=\"numero\">0</div>\n  <button id=\"boton\">Sumar</button>\n\n  <script>\n    var numero = document.getElementById(\"numero\");\n    var contador = 0;\n    document.getElementById(\"boton\").addEventListener(\"click\", function () {\n      contador++;\n      numero.textContent = contador;\n    });\n  </script>\n</body>\n</html>\n","workspace":"C:\\Users\\user\\Documents\\prject_local_AI\\reports\\viabilidad-2026-10-27\\eval-agente\\ws\\html-contador","ts":1793165143594}