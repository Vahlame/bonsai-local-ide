data: {"type":"action","id":"t1-a1","kind":"write","title":"server.mjs","state":"done","detail":"--- /dev/null\n+++ server.mjs\n+import { createServer } from 'node:http';\n+import { readFile, writeFile, promises as fsPromises } from 'node:fs';\n+import { extname, join, dirname, fileURLToPath } from 'node:path';\n+import { fileURLToPath as getFileURL } from 'node:url';\n+const __filename = fileURLToPath(import.meta.url);\n+const __dirname = dirname(__filename);\n+const dataFile = join(__dirname, 'tasks.json');\n+let tasks = [];\n+async function loadTasks() {\n+  try {\n+    const data = await fsPromises.readFile(dataFile, 'utf-8');\n+    tasks = JSON.parse(data);\n+  } catch (e) {\n+    if (e.code === 'ENOENT') {\n+      tasks = [];\n+      await fsPromises.writeFile(dataFile, '[]', 'utf-8');\n+    } else {\n+      console.error('Error loading tasks:', e);\n+      tasks = [];\n+    }\n+  }\n+}\n+async function saveTasks() {\n+  await fsPromises.writeFile(dataFile, JSON.stringify(tasks, null, 2), 'utf-8');\n+}\n+function generateId() {\n+  return tasks.length > 0 ? Math.max(...tasks.map(t => t.id)) + 1 : 1;\n+}\n+async function handleApi(req, res) {\n+  const { method, url } = req;\n+  const urlObj = new URL(url, `http://${req.headers.host}`);\n+  if (urlObj.pathname !== '/api/tasks') {\n+    res.writeHead(404);\n+    res.end('Not Found');\n+    return;\n+  }\n+  let body = '';\n+  for await (const chunk of req) body += chunk;\n+  if (body) {\n+    try { body = JSON.parse(body); } catch (e) { body = {}; }\n+  }\n+  if (method === 'GET') {\n+    res.writeHead(200, { 'Content-Type': 'application/json' });\n+    res.end(JSON.stringify(tasks));\n+  } else if (method === 'POST') {\n+    const { title } = body;\n+    if (!title) {\n+      res.writeHead(400);\n+      res.end('Title required');\n+      return;\n+    }\n+    const newTask = { id: generateId(), title, completed: false };\n+    tasks.push(newTask);\n+    await saveTasks();\n+    res.writeHead(201, { 'Content-Type': 'application/json' });\n+    res.end(JSON.stringify(newTask));\n+  } else if (method === 'PATCH') {\n+    const { id, completed } = body;\n+    const task = tasks.find(t => t.id === id);\n+    if (!task) {\n+      res.writeHead(404);\n+      res.end('Task not found');\n+      return;\n+    }\n+    if (typeof completed === 'boolean') task.completed = completed;\n+    await saveTasks();\n+    res.writeHead(200, { 'Content-Type': 'application/json' });\n+    res.end(JSON.stringify(task));\n+  } else if (method === 'DELETE') {\n+    const { id } = body;\n+    const index = tasks.findIndex(t => t.id === id);\n+    if (index === -1) {\n+      res.writeHead(404);\n+      res.end('Task not found');\n+      return;\n+    }\n+    tasks.splice(index, 1);\n+    await saveTasks();\n+    res.writeHead(200);\n+    res.end('Deleted');\n+  } else {\n+    res.writeHead(405);\n+    res.end('Method Not Allowed');\n+  }\n+}\n+async function serveStatic(req, res) {\n+  const urlObj = new URL(req.url, `http://${req.headers.host}`);\n+  let path = urlObj.pathname;\n+  if (path === '/') path = '/index.html';\n+  const filePath = join(__dirname, path);\n+  const ext = extname(filePath);\n+  const mimeTypes = {\n+    '.html': 'text/html',\n+    '.css': 'text/css',\n+    '.js': 'application/javascript',\n+    '.json': 'application/json'\n+  };\n+  const type = mimeTypes[ext] || 'application/octet-stream';\n+  try {\n+    const data = await fsPromises.readFile(filePath);\n+    res.writeHead(200, { 'Content-Type': type });\n+    res.end(data);\n+  } catch (e) {\n+    res.writeHead(404);\n+    res.end('Not Found');\n+  }\n+}\n+export async function startServer(port = 3000) {\n+  await loadTasks();\n+  const server = createServer(async (req, res) => {\n+    if (req.url.startsWith('/api/')) {\n+      await handleApi(req, res);\n+    } else {\n+      await serveStatic(req, res);\n+    }\n+  });\n+  await new Promise(resolve => server.listen(port, resolve));\n+  console.log(`Server running on http://localhost:${port}`);\n+  return server;\n+}\n+export function stopServer(server) {\n+  return new Promise(resolve => server.close(resolve));\n+}\n+// If run directly, start server\n+if (import.meta.url === `file://${process.argv[1]}`) {\n+  startServer();\n+}","undo":"mvxhqsl3-a4h4ab"}

