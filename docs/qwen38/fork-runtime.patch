+"""Record an isolated experiment with ETW PMCs; never use profiled timings as A/B results."""
+import argparse
+import hashlib
+import json
+import pathlib
+import shutil
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser()
+parser.add_argument("--label", required=True)
+parser.add_argument("--model", required=True)
+parser.add_argument("--env", action="append", default=[])
+parser.add_argument("--after-ms", type=int, default=25000)
+args = parser.parse_args()
+report_root = ROOT / "reports/2026-11-01-qwen38"
+prefix = report_root / args.label
+symbol_dir = report_root / (args.label + ".symbols")
+symbol_dir.mkdir()
+for pdb in (ROOT.parent / "build-Qwen38-sm89/bin").glob("*.pdb"):
+    shutil.copy2(pdb, symbol_dir / pdb.name)
+status = subprocess.check_output(["wpr", "-status"], text=True)
+if "WPR is not recording" not in status:
+    raise RuntimeError("Another WPR session is active; refusing to interfere")
+profile = ROOT / "scripts/qwen38-pmc.wprp"
+command = [sys.executable, str(ROOT / "scripts/qwen38_experiment.py"), "--label", args.label,
+           "--model", args.model, "--env", "LLAMA_MMAP_TRIM_GPU=1"]
+for entry in args.env:
+    command.extend(["--env", entry])
+start = ["wpr", "-start", str(profile) + "!Qwen38", "-filemode"]
+stop = ["wpr", "-stop", str(prefix) + ".etl", args.label]
+metadata = {"start_command": start, "experiment_command": command, "stop_command": stop,
+            "profile_sha256": hashlib.sha256(profile.read_bytes()).hexdigest(),
+            "sources": ["https://learn.microsoft.com/en-us/windows-hardware/test/wpt/recording-pmu-events",
+                        "https://github.com/amd/ZenDNN/blob/main/benchdnn/doc/perf_counters.md"],
+            "warning": "ETW sampling adds overhead. Use separate unprofiled experiments for performance decisions."}
+subprocess.run(start, check=True)
+try:
+    inventory = subprocess.check_output(["wpr", "-pmcsources"], text=True)
+    prefix.with_suffix(".pmcsources.txt").write_text(inventory)
+    subprocess.run(command, check=True)
+finally:
+    subprocess.run(stop, check=True)
+    prefix.with_suffix(".capture.json").write_text(json.dumps(metadata, indent=2))
+consumer = ROOT / "scripts/qwen38-etw/bin/qwen38-etw.dll"
+with prefix.with_suffix(".export.log").open("w") as log:
+    subprocess.run(["dotnet", str(consumer), str(prefix) + ".etl", str(prefix), str(args.after_ms),
+                    str(symbol_dir)],
+                   stdout=log, stderr=log, check=True)
