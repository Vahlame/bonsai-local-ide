new file mode 100644
index 0000000..1abbc15
--- /dev/null
+++ b/ggml/src/ggml-perf.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+// Opt-in experiment trace. No backend synchronization is added when disabled.
+static inline FILE * ggml_perf_open(const char * suffix) {
+    const char * prefix = getenv("GGML_PERF_CSV");
+    if (!prefix || !prefix[0]) {
+        return NULL;
+    }
+    char path[4096];
+    int n = snprintf(path, sizeof(path), "%s.%s.csv", prefix, suffix);
+    if (n < 0 || (size_t) n >= sizeof(path)) {
+        return NULL;
+    }
+    FILE * file = fopen(path, "ab+");
+    if (file) {
+        fseek(file, 0, SEEK_END);
+    }
+    if (file && ftell(file) == 0) {
+        fprintf(file, "start_us,stage,backend,node,op,weight_type,ne0,ne1,ne2,ne3,weight_bytes,threads,fused,elapsed_us,barrier_us,coordinator_cycles,instructions,ipc,stalls,frequency_mhz\n");
+    }
+    return file;
+}
+
+static inline uint64_t ggml_perf_cycles(void) {
+#if defined(_WIN32)
+    ULONG64 cycles = 0;
+    QueryThreadCycleTime(GetCurrentThread(), &cycles);
+    return cycles;
+#else
+    return 0;
+#endif
+}
+
+static inline void ggml_perf_row(FILE * file, const char * stage, const char * backend,
+        const struct ggml_tensor * node, int threads, int fused, int64_t start,
+        int64_t elapsed, int64_t barrier, uint64_t cycles) {
+    const struct ggml_tensor * weight = node->src[0];
+    fprintf(file, "%" PRId64 ",%s,%s,\"%s\",%s,%s,%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 ",%zu,%d,%d,%" PRId64 ",%" PRId64 ",%" PRIu64 ",NA,NA,NA,NA\n",
+            start, stage, backend, node->name, ggml_op_name(node->op), weight ? ggml_type_name(weight->type) : "none",
+            node->ne[0], node->ne[1], node->ne[2], node->ne[3], weight ? ggml_nbytes(weight) : 0,
+            threads, fused, elapsed, barrier, cycles);
+}
diff --git a/scripts/qwen38-bench.py b/scripts/qwen38-bench.py
new file mode 100644
index 0000000..24e826e
--- /dev/null
+++ b/scripts/qwen38-bench.py
@@ -0,0 +1,95 @@
+"""Deterministic server benchmark. Store every output and timing, including warmup."""
+import argparse
+import hashlib
+import json
+import pathlib
+import statistics
+import time
+import urllib.request
+
+
+def post(base, endpoint, data):
+    request = urllib.request.Request(base + endpoint, json.dumps(data).encode(), {"Content-Type": "application/json"})
+    return urllib.request.urlopen(request, timeout=1200)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--base", default="http://127.0.0.1:8080")
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--label", required=True)
+    parser.add_argument("--tokens", type=int, default=96)
+    parser.add_argument("--prompt-tokens", type=int, default=256)
+    parser.add_argument("--repetitions", type=int, default=3)
+    parser.add_argument("--cache", action="store_true")
+    parser.add_argument("--salt", default="")
+    parser.add_argument("--workload", choices=("repeat", "code", "prose"), default="repeat")
+    args = parser.parse_args()
+    output = pathlib.Path(args.out)
+    if output.exists():
+        raise FileExistsError(output)
+    deadline = time.monotonic() + 180
+    while True:
+        try:
+            with urllib.request.urlopen(args.base + "/health", timeout=3) as response:
+                if json.load(response).get("status") == "ok":
+                    break
+        except (OSError, ValueError):
+            pass
+        if time.monotonic() > deadline:
+            raise TimeoutError("Server was not ready within 180 seconds")
+        time.sleep(1)
+    corpus = args.salt + "// Implement a stable merge sort in Python with type hints. Explain complexity.\n" * 12000
+    if args.workload != "repeat":
+        prompts = {
+            "code": "Write a stable merge_sort(values: list[int]) -> list[int] in Python. Do not call sorted or list.sort. Include assertions for empty input, negative numbers, and duplicates. Explain its time and space complexity after the code.",
+            "prose": "Explica en espa├▒ol c├│mo ayuda un ├¡ndice B-tree a buscar filas en una base de datos. Usa una analog├¡a con una biblioteca, desarrolla un ejemplo concreto y explica los costes de lectura, escritura y memoria. Escribe una explicaci├│n extensa y clara."
+        }
+        with post(args.base, "/apply-template", {"messages": [{"role": "user", "content": prompts[args.workload]}],
+                                                "chat_template_kwargs": {"enable_thinking": False}, "add_generation_prompt": True}) as response:
+            corpus = json.load(response)["prompt"]
+    with post(args.base, "/tokenize", {"content": corpus, "add_special": True}) as response:
+        tokens = json.load(response)["tokens"]
+        if args.workload == "repeat":
+            tokens = tokens[:args.prompt_tokens]
+    report = {"label": args.label, "command": vars(args), "created_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+              "prompt_sha256": hashlib.sha256(json.dumps(tokens).encode()).hexdigest(), "prompt_actual_n": len(tokens), "prompt": tokens, "samples": []}
+    for repetition in range(args.repetitions + 1):
+        body = {"prompt": tokens, "n_predict": args.tokens, "temperature": 0, "seed": 42,
+                "cache_prompt": args.cache, "ignore_eos": True, "stream": True}
+        start = time.perf_counter()
+        first = None
+        content = ""
+        final = None
+        with post(args.base, "/completion", body) as response:
+            for raw in response:
+                if not raw.startswith(b"data: "):
+                    continue
+                if raw[6:].strip() == b"[DONE]":
+                    continue
+                event = json.loads(raw[6:])
+                if event.get("content"):
+                    if first is None:
+                        first = time.perf_counter()
+                    content += event["content"]
+                if "timings" in event:
+                    final = event
+        if final is None or final["timings"]["predicted_n"] < args.tokens:
+            raise RuntimeError(f"Incomplete generation: {final}")
+        sample = {"repetition": repetition, "warmup": repetition == 0, "ttft_ms": (first - start) * 1000 if first else None,
+                  "start_monotonic": start,
+                  "wall_ms": (time.perf_counter() - start) * 1000, "content": content, "final": final}
+        report["samples"].append(sample)
+        measured = report["samples"][1:]
+        if measured:
+            rates = [s["final"]["timings"]["predicted_per_second"] for s in measured]
+            report["summary"] = {"decode_median_tps": statistics.median(rates), "decode_min_tps": min(rates),
+                                 "decode_max_tps": max(rates), "decode_stdev_tps": statistics.stdev(rates) if len(rates) > 1 else 0,
+                                 "ttft_median_ms": statistics.median(s["ttft_ms"] for s in measured)}
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+        print(json.dumps({"rep": repetition, "ttft_ms": sample["ttft_ms"], "timings": final["timings"]}), flush=True)
+
+
+if __name__ == "__main__":
+    main()
