+workspace_expected = r"C:\Users\user\Documents\prject_local_AI"
+api("/api/workspace", {"path": workspace_expected})
+active = api("/api/chats", {"op": "new"})["active"]
+report = {"created_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "events": [],
+          "scope": "One real read-only agent task. This does not validate editing, cancellation, all failure paths or general quality.",
+          "workspace": workspace_expected,
+          "first_reasoning_ms": None, "first_text_ms": None, "first_action_ms": None}
+prompt = ("Lee docs/QWEN38-27B.md con la herramienta de lectura y responde cu├íl es el flag que activa MTP. "
+          "Esta tarea es de solo lectura: no modifiques archivos ni ejecutes comandos.")
+start = time.perf_counter()
+try:
+    with request("/api/chat", {"text": prompt, "modo": "agente"}) as response:
+        for line in response:
+            elapsed = (time.perf_counter() - start) * 1000
+            if elapsed > 300000:
+                raise TimeoutError("Read-only agent smoke exceeded 300 seconds; closing only this request")
+            if not line.startswith(b"data: "):
+                continue
+            event = json.loads(line[6:])
+            report["events"].append({"elapsed_ms": elapsed, **event})
+            kind = event.get("type")
+            if kind in ("reasoning", "token") and event.get("text"):
+                key = "first_reasoning_ms" if kind == "reasoning" else "first_text_ms"
+                if report[key] is None:
+                    report[key] = elapsed
+            if kind == "action" and report["first_action_ms"] is None:
+                report["first_action_ms"] = elapsed
+            if kind in ("action", "speed", "error", "done"):
+                print(json.dumps({"elapsed_ms": elapsed, **event}), flush=True)
+            OUT.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    done = next((e for e in reversed(report["events"]) if e.get("type") == "done"), {})
+    text = "".join(e.get("text", "") for e in report["events"] if e.get("type") == "token")
+    replacements = [e.get("text", "") for e in report["events"] if e.get("type") == "replace"]
+    if replacements:
+        text = replacements[-1]
+    read = any(e.get("type") == "action" and e.get("kind") == "read" and e.get("state") == "done"
+               and e.get("title") in ("leer", "buscar_codigo") and "no existe" not in e.get("detail", "").lower()
+               for e in report["events"])
+    report.update(wall_ms=(time.perf_counter() - start) * 1000, final_text=text, read_tool_completed=read,
+                  passed=bool(done and not done.get("incompleto") and read and "draft-mtp" in text and report["first_reasoning_ms"] is not None))
+except Exception as exc:
+    report.update(passed=False, error=str(exc), wall_ms=(time.perf_counter() - start) * 1000)
+finally:
+    try:
+        api("/api/workspace", {"path": workspace_before})
