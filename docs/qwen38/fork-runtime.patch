+        { cwd: root, windowsHide: true, stdio: 'inherit' });
+    const code = await new Promise((resolve, reject) => {
+        child.once('error', reject);
+        child.once('exit', resolve);
+    });
+    if (code !== 0) throw new Error(`Benchmark exited ${code}`);
+} finally {
+    await browser.close();
+}
