diff --git a/scripts/qwen38_placement.py b/scripts/qwen38_placement.py
new file mode 100644
index 0000000..e87b03f
--- /dev/null
+++ b/scripts/qwen38_placement.py
@@ -0,0 +1,80 @@
+"""Generate noncontiguous weight placement and an exact byte budget for the current GGUF."""
+import argparse
+import json
+import math
+import pathlib
+import re
+import subprocess
+import sys
+from qwen38_mixed_quant import TYPES, tensors, ROOT, PROJECT
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--policy", required=True, choices=("attention-gpu", "attention-balanced", "delta-gpu", "delta-projections-gpu"))
+parser.add_argument("--gpu-weight-budget-mib", type=int, default=5500)
+parser.add_argument("--execute", action="store_true")
+parser.add_argument("--quality-task", action="store_true")
+args = parser.parse_args()
+source = PROJECT / "models/qwen38-27b-Qwen3.8-27B-UD-IQ4_XS.gguf"
+overrides = []
+totals = {"CPU": 0, "CUDA0": 0}
+assignments = []
+source_tensors = tensors(source)
+extra_delta_layers = set()
+if args.policy == "attention-balanced":
+    layer_bytes = {}
+    fixed = 0
+    for tensor in source_tensors:
+        _, block, size = TYPES[tensor["type_id"]]
+        size = math.prod(tensor["shape"]) // block * size
+        match = re.match(r"blk\.(\d+)\.", tensor["name"])
+        if match and int(match[1]) < 64 and int(match[1]) % 4 != 3:
+            layer = int(match[1])
+            layer_bytes[layer] = layer_bytes.get(layer, 0) + size
+        elif tensor["name"] != "token_embd.weight":
+            fixed += size
+    # Spread the additional recurrent layers to measure noncontiguous transitions.
+    candidates = sorted(layer_bytes, key=lambda layer: (layer % 3, layer))
+    for layer in candidates:
+        if fixed + layer_bytes[layer] <= args.gpu_weight_budget_mib * 1048576:
+            fixed += layer_bytes[layer]
+            extra_delta_layers.add(layer)
+for tensor in source_tensors:
+    name = tensor["name"]
+    match = re.match(r"blk\.(\d+)\.", name)
+    device = "CUDA0"
+    if name == "token_embd.weight":
+        device = "CPU"
+    if match:
+        layer = int(match[1])
+        if layer < 64:
+            attention = layer % 4 == 3
+            if args.policy in ("attention-gpu", "attention-balanced"):
+                device = "CUDA0" if attention or layer in extra_delta_layers else "CPU"
+            elif args.policy == "delta-gpu":
+                device = "CPU" if attention else "CUDA0"
+            else:
+                device = "CUDA0" if not attention and ".ffn_" not in name else "CPU"
+    _, block, size = TYPES[tensor["type_id"]]
+    size = math.prod(tensor["shape"]) // block * size
+    totals[device] += size
+    assignments.append({"name": name, "device": device, "bytes": size})
+    if device == "CPU":
+        overrides.append("^" + re.escape(name) + "$=CPU")
+label = "placement-" + args.policy + ("-quality" if args.quality_task else "")
+command = [sys.executable, str(ROOT / "scripts/qwen38_experiment.py"), "--label", label,
+           "--env", "LLAMA_DEVICE_FROM_PROJECTION=1", "--env", "LLAMA_MMAP_TRIM_GPU=1",
+           "--gpu-layers", "99"]
+if args.quality_task:
+    command.append("--quality-task")
+command.extend(["--server-arg=--override-tensor", "--server-arg=" + ",".join(overrides)])
+report = {"policy": args.policy, "weights_mib": {k: v / 1048576 for k, v in totals.items()}, "command": command,
+          "gpu_weights_fit_physical_vram": totals["CUDA0"] <= 8188 * 1048576,
+          "extra_delta_layers": sorted(extra_delta_layers),
+          "assignments": assignments, "note": "The state device follows the attention/SSM output projection when LLAMA_DEVICE_FROM_PROJECTION=1. Full-KV and recurrent-state allocations still require separate budget."}
+path = ROOT / f"reports/2026-11-01-qwen38/placement-plan-{args.policy}.json"
+path.write_text(json.dumps(report, indent=2))
+print(json.dumps(report["weights_mib"]))
+if args.execute:
+    if totals["CUDA0"] > 8188 * 1048576:
+        raise RuntimeError("Rejected before allocation: GPU weights alone exceed the physical VRAM; try attention-balanced")
+    subprocess.run(command, check=True)
