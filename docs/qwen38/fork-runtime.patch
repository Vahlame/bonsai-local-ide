+}
+$env:CUDA_PATH = $tools.cudaRoot
+if ($Symbols) {
+    & $tools.cmake -S (Split-Path -Parent $PSScriptRoot) -B $build `
+        '-DCMAKE_C_FLAGS_RELEASE=/O2 /Ob2 /DNDEBUG /Zi' `
+        '-DCMAKE_CXX_FLAGS_RELEASE=/O2 /Ob2 /DNDEBUG /Zi' `
+        '-DCMAKE_SHARED_LINKER_FLAGS_RELEASE=/DEBUG:FULL /OPT:REF /OPT:ICF' `
+        '-DCMAKE_EXE_LINKER_FLAGS_RELEASE=/DEBUG:FULL /OPT:REF /OPT:ICF'
