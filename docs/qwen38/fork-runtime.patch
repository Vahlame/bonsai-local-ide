+++ b/scripts/qwen38_memory_profile.py
@@ -0,0 +1,45 @@
+"""Lightweight ETW fault capture around an isolated benchmark, with file attribution."""
+import argparse
+import json
+import pathlib
+import subprocess
+import sys
+import time
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser()
+parser.add_argument("--label", required=True)
+parser.add_argument("--model", required=True)
+parser.add_argument("--env", action="append", default=[])
+parser.add_argument("--allocator-weights", action="store_true")
+parser.add_argument("--cache-contexts", action="store_true")
+parser.add_argument("--cache", action="store_true")
+parser.add_argument("--after-ms", type=int, default=25000)
+args = parser.parse_args()
+prefix = ROOT / "reports/2026-11-01-qwen38" / args.label
+if "WPR is not recording" not in subprocess.check_output(["wpr", "-status"], text=True):
+    raise RuntimeError("Another WPR session is active")
+command = [sys.executable, str(ROOT / "scripts/qwen38_experiment.py"), "--label", args.label,
+           "--model", args.model]
+if args.allocator_weights:
+    command.append("--allocator-weights")
+if args.cache_contexts:
+    command.append("--cache-contexts")
+if args.cache:
+    command.append("--cache")
+for entry in args.env:
+    command.extend(["--env", entry])
+start = ["wpr", "-start", str(ROOT / "scripts/qwen38-memory.wprp") + "!QwenMemory", "-filemode"]
+stop = ["wpr", "-stop", str(prefix) + ".etl", args.label]
+prefix.with_suffix(".capture.json").write_text(json.dumps({"start": start, "experiment": command,
+    "stop": stop, "start_command_monotonic": time.monotonic(),
+    "note": "AllFaults and FileIO tracing is used for fault attribution, not speed decisions."}, indent=2))
+subprocess.run(start, check=True)
+try:
+    subprocess.run(command, check=True)
+finally:
+    subprocess.run(stop, check=True)
