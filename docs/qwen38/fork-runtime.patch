diff --git a/scripts/qwen38_mixed_quant.py b/scripts/qwen38_mixed_quant.py
new file mode 100644
index 0000000..7caf56d
--- /dev/null
+++ b/scripts/qwen38_mixed_quant.py
@@ -0,0 +1,109 @@
+"""Build a selective requantization plan with a four-bit floor and protected high-precision tensors."""
+import argparse
+import json
+import math
+import pathlib
+import re
+import struct
+import subprocess
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PROJECT = pathlib.Path(r"C:\Users\user\Documents\prject_local_AI")
+TYPES = {0: ("f32", 1, 4), 1: ("f16", 1, 2), 2: ("q4_0", 32, 18), 3: ("q4_1", 32, 20),
+         6: ("q5_0", 32, 22), 7: ("q5_1", 32, 24), 8: ("q8_0", 32, 34),
+         10: ("q2_K", 256, 84), 11: ("q3_K", 256, 110), 12: ("q4_K", 256, 144),
+         13: ("q5_K", 256, 176), 14: ("q6_K", 256, 210), 16: ("iq2_xxs", 256, 66),
+         17: ("iq2_xs", 256, 74), 18: ("iq3_xxs", 256, 98), 20: ("iq4_nl", 32, 18),
+         21: ("iq3_s", 256, 110), 22: ("iq2_s", 256, 82), 23: ("iq4_xs", 256, 136), 30: ("bf16", 1, 2)}
+BY_NAME = {value[0]: key for key, value in TYPES.items()}
+
+
+def tensors(path):
+    with path.open("rb") as stream:
+        def number(fmt):
+            return struct.unpack("<" + fmt, stream.read(struct.calcsize(fmt)))[0]
+        def string():
+            return stream.read(number("Q")).decode("utf-8")
+        formats = {0: "B", 1: "b", 2: "H", 3: "h", 4: "I", 5: "i", 6: "f", 7: "?", 10: "Q", 11: "q", 12: "d"}
+        def skip(kind):
+            if kind == 8:
+                stream.seek(number("Q"), 1)
+            elif kind == 9:
+                element, count = number("I"), number("Q")
+                if element in formats:
+                    stream.seek(count * struct.calcsize(formats[element]), 1)
+                else:
+                    for _ in range(count):
+                        skip(element)
+            else:
+                stream.seek(struct.calcsize(formats[kind]), 1)
+        if stream.read(4) != b"GGUF" or number("I") != 3:
+            raise ValueError("Expected GGUF v3")
+        count, metadata = number("Q"), number("Q")
+        for _ in range(metadata):
+            string()
+            skip(number("I"))
+        result = []
+        for _ in range(count):
+            name = string()
+            shape = [number("Q") for _ in range(number("I"))]
+            kind, offset = number("I"), number("Q")
+            result.append({"name": name, "shape": shape, "type_id": kind, "offset": offset})
+        return result
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--cpu-type", choices=("q4_0", "q4_K", "iq4_xs"), required=True)
+    parser.add_argument("--cpu-layers", type=int)
+    parser.add_argument("--gpu-layers", type=int, default=27)
+    parser.add_argument("--execute", action="store_true")
+    args = parser.parse_args()
+    source = PROJECT / "models/qwen38-27b-Qwen3.8-27B-UD-IQ4_XS.gguf"
+    target = PROJECT / f"models/qwen38-27b-perf-{args.cpu_type.lower()}-floor4.gguf"
+    quantize = pathlib.Path(r"C:\Users\user\.local\opt\bonsai-inference\build-Qwen38-sm89\bin\llama-quantize.exe")
+    command = [str(quantize), "--allow-requantize"]
+    tensor_options = []
+    plan = []
+    estimates = {"cpu": 0, "gpu": 0}
+    source_tensors = tensors(source)
+    layer_ids = [int(m[1]) for t in source_tensors if (m := re.match(r"blk\.(\d+)\.", t["name"]))]
+    cpu_layers = args.cpu_layers if args.cpu_layers is not None else max(0, max(layer_ids) + 2 - args.gpu_layers)
+    for tensor in source_tensors:
+        name = tensor["name"]
+        original, block, block_bytes = TYPES[tensor["type_id"]]
+        match = re.match(r"blk\.(\d+)\.", name)
+        cpu = name == "token_embd.weight" or (match and int(match[1]) < cpu_layers)
+        chosen = original
+        if len(tensor["shape"]) >= 2 and block > 1:
+            if cpu and name != "token_embd.weight" and block_bytes * 8 / block <= 4.5:
+                chosen = args.cpu_type
+            elif block_bytes * 8 / block < 4:
+                chosen = "iq4_xs"
+            tensor_options.append("^" + re.escape(name) + "$=" + chosen)
+        _, out_block, out_bytes = TYPES[BY_NAME[chosen]]
+        nbytes = math.prod(tensor["shape"]) // out_block * out_bytes
+        estimates["cpu" if cpu else "gpu"] += nbytes
+        plan.append({"name": name, "original": original, "chosen": chosen, "cpu": bool(cpu), "estimated_bytes": nbytes})
+    types_file = ROOT / f"reports/2026-11-01-qwen38/quant-{args.cpu_type.lower()}.tensor-types.txt"
+    types_file.write_text("\n".join(tensor_options) + "\n")
+    command.extend(["--tensor-type-file", str(types_file), str(source), str(target), "IQ4_XS", "16"])
+    output = ROOT / f"reports/2026-11-01-qwen38/quant-{args.cpu_type.lower()}.json"
+    report = {"command": command, "source": str(source), "target": str(target), "policy": "Never create tensors below four bits; preserve existing types above 4.5 bpw. Source is already quantized; this is requantization, not recovery of lost precision.",
+              "estimated_weights_mib": {k: v / 1048576 for k, v in estimates.items()}, "tensors": plan}
+    output.write_text(json.dumps(report, indent=2))
+    print(json.dumps(report["estimated_weights_mib"]))
+    if args.execute:
+        if target.exists():
+            raise FileExistsError(target)
+        with output.with_suffix(".log").open("w") as log:
+            subprocess.run(command, stdout=log, stderr=log, check=True)
+        result = tensors(target)
+        assert all(TYPES[t["type_id"]][2] * 8 / TYPES[t["type_id"]][1] >= 4 for t in result)
+        report["validated_four_bit_floor"] = True
+        report["output_bytes"] = target.stat().st_size
+        output.write_text(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
