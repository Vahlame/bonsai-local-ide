new file mode 100644
index 0000000..cc847e7
--- /dev/null
+++ b/scripts/qwen38_pmc_summary.py
@@ -0,0 +1,59 @@
+"""Derive sampled, per-function PMC estimates after checking source IDs and intervals."""
+import argparse
+import collections
+import csv
+import json
+import pathlib
+import re
+
+parser = argparse.ArgumentParser()
+parser.add_argument("prefix", type=pathlib.Path)
+args = parser.parse_args()
+prefix = str(args.prefix)
+inventory = pathlib.Path(prefix + ".pmcsources.txt").read_text()
+ids = {name: key for key, name in re.findall(r"^\s*(\d+)\s+(\w+)\s+\d+", inventory, re.M)}
+metadata = json.loads(pathlib.Path(prefix + ".metadata.json").read_text())
+intervals = {}
+for event in metadata["source_examples"].values():
+    if 'EventName="PerfInfo/CollectionStart"' not in event:
+        continue
+    match = re.search(r'SampleSource="(\d+)" NewInterval="([\d,]+)"', event)
+    if match:
+        intervals[match[1]] = int(match[2].replace(",", ""))
+names = ("FRRetiredx86Instructions", "Qwen38Cycles", "Qwen38FpSchedulerStalls", "Qwen38LoadQueueStalls")
+for name in names:
+    if name not in ids or ids[name] not in intervals:
+        raise RuntimeError(f"Missing hardware source/interval: {name}")
+functions = collections.defaultdict(collections.Counter)
+with pathlib.Path(prefix + ".functions.csv").open(newline="") as stream:
+    for row in csv.DictReader(stream):
+        functions[row["function"]][row["source"]] += int(row["samples"])
+timer_interval_ms = intervals.get("0", 10000) / 10000
+table = []
+for function, counts in functions.items():
+    samples = counts["timer"]
+    events = {name: counts[ids[name]] * intervals[ids[name]] for name in names}
+    cycles = events["Qwen38Cycles"]
+    enough = counts[ids["Qwen38Cycles"]] >= 30
+    table.append({"function": function, "exclusive_ms_estimate": samples * timer_interval_ms,
+                  "percent": samples * 100 / metadata["timer_samples"] if metadata["timer_samples"] else 0,
+                  "timer_samples": samples, "pmc_samples": {name: counts[ids[name]] for name in names},
+                  "cycles_estimate": cycles, "instructions_estimate": events["FRRetiredx86Instructions"],
+                  "ipc_estimate": events["FRRetiredx86Instructions"] / cycles if enough else None,
+                  "fp_scheduler_stalls_per_cycle_estimate": events["Qwen38FpSchedulerStalls"] / cycles if enough else None,
+                  "load_queue_stalls_per_cycle_estimate": events["Qwen38LoadQueueStalls"] / cycles if enough else None,
+                  "frequency_mhz_estimate": cycles / (samples * timer_interval_ms * 1000) if enough and samples >= 30 else None})
+table.sort(key=lambda row: row["percent"], reverse=True)
+report = {"function_table": table, "hard_fault_count": metadata["hard_fault_count"],
+          "intervals": intervals, "source_ids": {name: ids[name] for name in names},
+          "limitations": ["PMC estimates use overflow sample counts multiplied by measured sampling intervals, with skid and sampling uncertainty.",
+                          "IPC and stall ratios below 30 cycle samples are omitted. Stall events may overlap and are not additive percentages of runtime.",
+                          "Frequency is estimated from unhalted-cycle samples divided by timer-sampled CPU time, not an instantaneous clock measurement.",
+                          "Only exclusive samples in llama-server after the requested cutoff are included; profiled throughput is not an A/B result."]}
+pathlib.Path(prefix + ".summary.json").write_text(json.dumps(report, indent=2))
+with pathlib.Path(prefix + ".summary.csv").open("w", newline="") as stream:
+    fields = [key for key in table[0] if key != "pmc_samples"] if table else ["function"]
+    writer = csv.DictWriter(stream, fieldnames=fields, extrasaction="ignore")
+    writer.writeheader()
+    writer.writerows(table)
+print(json.dumps({"top_functions": table[:12], "hard_fault_count": metadata["hard_fault_count"]}, indent=2))
