+"""Capture token probabilities and native tool round trips against a running server."""
+import argparse
+import ast
+import json
+import pathlib
+import re
+import subprocess
+import sys
+import urllib.request
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--out", type=pathlib.Path, required=True)
+parser.add_argument("--base", default="http://127.0.0.1:8080")
+parser.add_argument("--task", action="store_true")
+args = parser.parse_args()
+
+
+def post(endpoint, body):
+    request = urllib.request.Request(args.base + endpoint, json.dumps(body).encode(), {"Content-Type": "application/json"})
+    with urllib.request.urlopen(request, timeout=600) as response:
+        return json.load(response)
+
+
+report = {"logprobs": [], "tool": {}}
+for prompt in ["def clamp(value, low, high):\n    return", "The prime numbers smaller than twenty are", "La capital de Costa Rica es"]:
+    result = post("/completion", {"prompt": prompt, "n_predict": 24, "n_probs": 10, "temperature": 0,
+                                 "seed": 42, "cache_prompt": False, "ignore_eos": True})
+    report["logprobs"].append({"prompt": prompt, "response": result})
+    args.out.write_text(json.dumps(report, indent=2))
+
+tools = [{"type": "function", "function": {"name": "sum_numbers", "description": "Add two integers.",
+         "parameters": {"type": "object", "properties": {"a": {"type": "integer"}, "b": {"type": "integer"}},
+                        "required": ["a", "b"], "additionalProperties": False}}}]
+messages = [{"role": "user", "content": "Use sum_numbers to add 17 and 25. Then state the result in one sentence."}]
+body = {"model": "local", "messages": messages, "tools": tools, "temperature": 0, "seed": 42,
+        "max_tokens": 96, "chat_template_kwargs": {"enable_thinking": False}}
+first = post("/v1/chat/completions", body)
+report["tool"]["first"] = first
+message = first["choices"][0]["message"]
+calls = message.get("tool_calls", [])
+report["tool"]["native_tool_called"] = len(calls) == 1 and calls[0]["function"]["name"] == "sum_numbers"
+if report["tool"]["native_tool_called"]:
+    values = json.loads(calls[0]["function"]["arguments"])
+    report["tool"]["arguments_correct"] = values == {"a": 17, "b": 25}
+    messages.append(message)
+    messages.append({"role": "tool", "tool_call_id": calls[0]["id"], "content": json.dumps({"result": values["a"] + values["b"]})})
+    second = post("/v1/chat/completions", body)
+    report["tool"]["second"] = second
+    report["tool"]["answer_correct"] = "42" in (second["choices"][0]["message"].get("content") or "")
+reasoning = post("/v1/chat/completions", {"model": "local", "messages": [{"role": "user", "content": "What is 17 + 25? Give the result."}],
+                 "temperature": 0, "seed": 42, "max_tokens": 128, "chat_template_kwargs": {"enable_thinking": True},
+                 "reasoning_format": "deepseek"})
+report["reasoning"] = reasoning
+if args.task:
+    task = post("/v1/chat/completions", {"model": "local", "messages": [{"role": "user", "content":
+        "Write only Python code, no imports: def encode_runs(text: str) -> list[tuple[str, int]]: "
+        "Return consecutive run-length pairs. Empty input returns []. Example: 'aaabbc' returns "
+        "[('a', 3), ('b', 2), ('c', 1)]. Do not include tests or explanation."}],
+        "temperature": 0, "seed": 42, "max_tokens": 512, "chat_template_kwargs": {"enable_thinking": False}})
+    content = task["choices"][0]["message"].get("content") or ""
+    code = re.sub(r"^```(?:python)?\s*|\s*```$", "", content.strip())
+    report["code_task"] = {"response": task, "code": code, "passed": False}
+    try:
+        tree = ast.parse(code)
+        # Reject imports, reflection, arbitrary attributes and other side effects before execution.
+        allowed = (ast.Module, ast.FunctionDef, ast.arguments, ast.arg, ast.Return, ast.Assign, ast.AnnAssign,
+                   ast.AugAssign, ast.Name, ast.Load, ast.Store, ast.Constant, ast.List, ast.Tuple, ast.Subscript,
+                   ast.Slice, ast.For, ast.If, ast.Compare, ast.Eq, ast.NotEq, ast.Lt, ast.LtE, ast.Gt, ast.GtE,
+                   ast.BoolOp, ast.And, ast.Or, ast.UnaryOp, ast.Not, ast.USub, ast.BinOp, ast.Add, ast.Sub,
+                   ast.Call, ast.Attribute, ast.Expr, ast.Pass, ast.Break, ast.Continue, ast.IfExp)
+        for node in ast.walk(tree):
+            if not isinstance(node, allowed):
+                raise ValueError(f"Unsupported task syntax: {type(node).__name__}")
+            if isinstance(node, ast.Name) and node.id.startswith("_"):
+                raise ValueError("Private names are forbidden")
+            if isinstance(node, ast.Attribute) and node.attr != "append":
+                raise ValueError("Only list.append is permitted")
+            if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id not in ("len", "range", "enumerate", "zip", "list", "tuple"):
+                raise ValueError("Unapproved call")
+        tests = "\nassert encode_runs('') == []\nassert encode_runs('a') == [('a',1)]\nassert encode_runs('aaabbc') == [('a',3),('b',2),('c',1)]\nassert encode_runs('ababa') == [('a',1),('b',1),('a',1),('b',1),('a',1)]\nassert encode_runs(chr(233)*17+'x') == [(chr(233),17),('x',1)]\nassert encode_runs('x'*10000) == [('x',10000)]\n"
+        result = subprocess.run([sys.executable, "-I", "-c", code + tests], timeout=5, capture_output=True, text=True)
+        report["code_task"].update(passed=result.returncode == 0, stderr=result.stderr, tested_cases=6)
+    except (ValueError, SyntaxError, subprocess.TimeoutExpired) as error:
+        report["code_task"]["error"] = str(error)
+reasoning_message = reasoning["choices"][0]["message"]
+report["passed"] = all(report["tool"].get(key) for key in ("native_tool_called", "arguments_correct", "answer_correct"))
+report["passed"] = report["passed"] and bool(reasoning_message.get("reasoning_content")) and "42" in (reasoning_message.get("content") or "")
+if args.task:
+    report["passed"] = report["passed"] and report["code_task"]["passed"]
+args.out.write_text(json.dumps(report, indent=2))
+print(json.dumps({"tool_called": report["tool"].get("native_tool_called"), "tool_arguments_correct": report["tool"].get("arguments_correct"),
+                  "tool_answer_correct": report["tool"].get("answer_correct"), "reasoning_message": reasoning["choices"][0]["message"]}))
+assert report["passed"], f"Quality gate failed; see {args.out}"
diff --git a/scripts/qwen38_quality_compare.py b/scripts/qwen38_quality_compare.py
new file mode 100644
index 0000000..5faac41
--- /dev/null
+++ b/scripts/qwen38_quality_compare.py
@@ -0,0 +1,33 @@
+import argparse
+import json
+import math
+import pathlib
+
+parser = argparse.ArgumentParser()
+parser.add_argument("reference", type=pathlib.Path)
+parser.add_argument("candidate", type=pathlib.Path)
+args = parser.parse_args()
+reference = json.loads(args.reference.read_text())
+candidate = json.loads(args.candidate.read_text())
+cases = []
+for ref, cur in zip(reference["logprobs"], candidate["logprobs"]):
+    a, b = ref["response"], cur["response"]
+    diffs = []
+    ids_equal = True
+    for x, y in zip(a["completion_probabilities"], b["completion_probabilities"]):
+        ids_equal = ids_equal and x["id"] == y["id"]
+        px = {v["id"]: v["logprob"] for v in x["top_logprobs"]}
+        py = {v["id"]: v["logprob"] for v in y["top_logprobs"]}
+        diffs.extend(abs(math.exp(px[k]) - math.exp(py[k])) for k in px.keys() & py.keys())
+    nll_a = -sum(v["logprob"] for v in a["completion_probabilities"]) / len(a["completion_probabilities"])
+    nll_b = -sum(v["logprob"] for v in b["completion_probabilities"]) / len(b["completion_probabilities"])
+    cases.append({"prompt": ref["prompt"], "same_output": a["content"] == b["content"], "same_token_ids": ids_equal,
+                  "max_top_probability_delta": max(diffs), "reference_generated_nll": nll_a, "candidate_generated_nll": nll_b})
+result = {"cases": cases, "candidate_tool": {k: v for k, v in candidate["tool"].items() if isinstance(v, bool)},
+          "reasoning_output_same": reference["reasoning"]["choices"][0]["message"] == candidate["reasoning"]["choices"][0]["message"],
+          "note": "Generated-token NLL is a logits check, not held-out corpus perplexity."}
+result["passed"] = all(v["same_output"] and v["same_token_ids"] and v["max_top_probability_delta"] < 0.001 for v in cases)
+result["passed"] = result["passed"] and all(result["candidate_tool"].values()) and result["reasoning_output_same"]
+args.candidate.with_name("comparison.json").write_text(json.dumps(result, indent=2))
+print(json.dumps(result, indent=2))
+assert result["passed"]
