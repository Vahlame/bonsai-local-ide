new file mode 100644
index 0000000..25c0836
--- /dev/null
+++ b/scripts/qwen38_uprof.py
@@ -0,0 +1,48 @@
+"""Cross-check the ETW PMC profile with the official AMD profiler."""
+import json
+import pathlib
+import shutil
+import subprocess
+import sys
+import time
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+out = ROOT / "reports/2026-11-01-qwen38/uprof-attached"
+out.mkdir()
+symbols = out / "symbols"
+symbols.mkdir()
+for pdb in (ROOT.parent / "build-Qwen38-sm89/bin").glob("*.pdb"):
+    shutil.copy2(pdb, symbols / pdb.name)
+model = r"C:/Users/user/Documents/prject_local_AI/models/qwen38-27b-perf-iq4_xs-floor4.gguf"
+server_dir = out.parent / "uprof-attached-server"
+harness = [sys.executable, str(ROOT / "scripts/qwen38_experiment.py"), "--label", "uprof-attached-server",
+           "--model", model, "--env", "LLAMA_MMAP_TRIM_GPU=1"]
+runner = subprocess.Popen(harness, cwd=ROOT)
+deadline = time.monotonic() + 30
+try:
+    while True:
+        manifest = server_dir / "manifest.json"
+        if manifest.exists():
+            try:
+                pid = json.loads(manifest.read_text())["server_pid"]
+                break
+            except (KeyError, json.JSONDecodeError):
+                pass
+        if runner.poll() is not None:
+            raise RuntimeError("Server harness exited before publishing its PID")
+        if time.monotonic() > deadline:
+            raise TimeoutError("Server PID not published")
+        time.sleep(0.1)
+    command = [r"C:\Program Files\AMD\AMDuProf\bin\AMDuProfCLI.exe", "profile", "--pid", str(pid),
+           "--config", "assess", "--config", "tbp", "--interval", "10000000",
+           "--start-delay", "25", "--duration", "45", "-o", str(out)]
+    report = {"command": command, "harness_command": harness, "server_pid": pid,
+              "note": "Attach to the actual server PID. Profiled timings are excluded from performance decisions."}
+    (out / "command.json").write_text(json.dumps(report, indent=2))
+    result = subprocess.run(command, cwd=ROOT)
+    report["exit_code"] = result.returncode
+    (out / "command.json").write_text(json.dumps(report, indent=2))
+finally:
+    # The harness owns the server and performs its cleanup after all requests.
+    runner.wait()
+raise SystemExit(result.returncode)
