index 0000000..f567b22
--- /dev/null
+++ b/ggml/src/ggml-cpu/arch/x86/iq4-mtp.cpp
@@ -0,0 +1,101 @@
+#include "../../quants.h"
+#include "../../ggml-cpu-impl.h"
+#include "../../simd-mappings.h"
+
+#define GGML_COMMON_IMPL_CPP
+#include "ggml-common.h"
+
+#include <cassert>
+#include <cstdlib>
+
+#if defined(__AVX512F__) && (defined(__AVX512VNNI__) || defined(_MSC_VER))
+#include <immintrin.h>
+#if defined(_MSC_VER)
+#include <intrin.h>
+#endif
+
+bool ggml_cpu_iq4_mtp_vnni(void) {
+    static const bool enabled = [] {
+        const char * env = std::getenv("GGML_CPU_IQ4_MTP");
+        if (env && std::atoi(env) == 0) {
+            return false;
+        }
+#if defined(_MSC_VER)
+        int regs[4];
+        __cpuidex(regs, 7, 0);
+        return (regs[2] & (1 << 11)) != 0;
+#else
+        return true;
+#endif
+    }();
+    return enabled;
+}
+
+template <int NC>
+static void iq4_mtp_dot(int n, float * s, const block_iq4_xs * x, const char * activations, size_t stride) {
+    const __m128i mask = _mm_set1_epi8(15);
+    const __m128i lut = _mm_loadu_si128((const __m128i *) kvalues_iq4nl);
+    __m256 result[NC];
+    for (int col = 0; col < NC; ++col) {
+        result[col] = _mm256_setzero_ps();
+    }
+    for (int block = 0; block < n / QK_K; ++block) {
+        __m512i sums[NC];
+        for (int col = 0; col < NC; ++col) {
+            sums[col] = _mm512_setzero_si512();
+        }
+        for (int pair = 0; pair < 4; ++pair) {
+            const int lo = ((x[block].scales_l[pair] & 15) | (((x[block].scales_h >> (4 * pair)) & 3) << 4)) - 32;
+            const int hi = ((x[block].scales_l[pair] >> 4) | (((x[block].scales_h >> (4 * pair + 2)) & 3) << 4)) - 32;
+            const __m128i p0 = _mm_loadu_si128((const __m128i *) (x[block].qs + pair * 32));
+            const __m128i p1 = _mm_loadu_si128((const __m128i *) (x[block].qs + pair * 32 + 16));
+            const __m256i q0 = _mm256_set_m128i(_mm_shuffle_epi8(lut, _mm_and_si128(_mm_srli_epi16(p0, 4), mask)), _mm_shuffle_epi8(lut, _mm_and_si128(p0, mask)));
+            const __m256i q1 = _mm256_set_m128i(_mm_shuffle_epi8(lut, _mm_and_si128(_mm_srli_epi16(p1, 4), mask)), _mm_shuffle_epi8(lut, _mm_and_si128(p1, mask)));
+            const __m512i q = _mm512_inserti64x4(_mm512_castsi256_si512(q0), q1, 1);
+            const __m512i magnitude = _mm512_abs_epi8(q);
+            const __mmask64 negative = _mm512_movepi8_mask(q);
+            const __m512i scale = _mm512_inserti64x4(_mm512_castsi256_si512(_mm256_set1_epi32(lo)), _mm256_set1_epi32(hi), 1);
+            for (int col = 0; col < NC; ++col) {
+                const auto * y = (const block_q8_K *) (activations + col * stride);
+                const __m512i a = _mm512_loadu_si512((const void *) (y[block].qs + pair * 64));
+                const __m512i signed_a = _mm512_mask_sub_epi8(a, negative, _mm512_setzero_si512(), a);
+                const __m512i dot = _mm512_dpbusd_epi32(_mm512_setzero_si512(), magnitude, signed_a);
+                sums[col] = _mm512_add_epi32(sums[col], _mm512_mullo_epi32(dot, scale));
+            }
+        }
+        for (int col = 0; col < NC; ++col) {
+            const auto * y = (const block_q8_K *) (activations + col * stride);
+            const __m256i value = _mm256_add_epi32(_mm512_castsi512_si256(sums[col]), _mm512_extracti64x4_epi64(sums[col], 1));
+            const float d = GGML_CPU_FP16_TO_FP32(x[block].d) * y[block].d;
+            result[col] = _mm256_fmadd_ps(_mm256_set1_ps(d), _mm256_cvtepi32_ps(value), result[col]);
+        }
+    }
+    for (int col = 0; col < NC; ++col) {
+        __m128 sum = _mm_add_ps(_mm256_extractf128_ps(result[col], 1), _mm256_castps256_ps128(result[col]));
+        sum = _mm_add_ps(sum, _mm_movehl_ps(sum, sum));
+        sum = _mm_add_ss(sum, _mm_movehdup_ps(sum));
+        s[col] = _mm_cvtss_f32(sum);
+    }
+}
+
+void ggml_vec_dot_iq4_xs_q8_K_mtp(int n, float * s, const void * vx, const void * vy, size_t by, int ncols) {
+    assert(n % QK_K == 0 && ncols >= 1 && ncols <= 3);
+    const auto * x = (const block_iq4_xs *) vx;
+    const auto * y = (const char *) vy;
+    switch (ncols) {
+        case 1: iq4_mtp_dot<1>(n, s, x, y, by); break;
+        case 2: iq4_mtp_dot<2>(n, s, x, y, by); break;
+        case 3: iq4_mtp_dot<3>(n, s, x, y, by); break;
+    }
+}
+#else
+bool ggml_cpu_iq4_mtp_vnni(void) {
+    return false;
+}
+
+void ggml_vec_dot_iq4_xs_q8_K_mtp(int n, float * s, const void * vx, const void * vy, size_t by, int ncols) {
+    for (int col = 0; col < ncols; ++col) {
+        ggml_vec_dot_iq4_xs_q8_K(n, s + col, 0, vx, 0, (const char *) vy + col * by, 0, 1);
+    }
+}
+#endif
