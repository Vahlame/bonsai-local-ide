+"""Rebuild one CUDA geometry variable, then run isolated speed/quality checks."""
+import argparse
+import json
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+REPORT = ROOT / "reports/2026-11-01-qwen38"
+MODEL = r"C:\Users\user\Documents\prject_local_AI\models\qwen38-27b-perf-iq4_xs-floor4.gguf"
+parser = argparse.ArgumentParser()
+parser.add_argument("--variant", required=True, choices=("mmvq2", "mmvq2-verify", "mmvq2-iq4", "mmvq4"))
+parser.add_argument("--build-only", action="store_true")
+args = parser.parse_args()
+label = "cuda-" + args.variant
+build_log = REPORT / (label + ".build.log")
+if build_log.exists():
+    raise FileExistsError(build_log)
+relative = "ggml/src/ggml-cuda/mmvq.cu"
+source = subprocess.check_output(["git", "show", "dde879b:" + relative], cwd=ROOT).decode()
+begin = source.index("static constexpr __host__ __device__ int calc_nwarps(")
+end = source.index("} else if (table_id == MMVQ_PARAMETERS_GCN)", begin)
+section = source[begin:end]
+assert section.count("return 4;") == 1
+replacement = {"mmvq2": "return 2;", "mmvq2-verify": "return ncols_dst == 3 ? 2 : 4;",
+               "mmvq2-iq4": "return type == GGML_TYPE_IQ4_XS ? 2 : 4;", "mmvq4": "return 4;"}[args.variant]
+section = section.replace("return 4;", replacement)
+(ROOT / relative).write_text(source[:begin] + section + source[end:], encoding="utf-8")
+diff = subprocess.check_output(["git", "diff", "HEAD", "--", "ggml/src/ggml-cuda"], cwd=ROOT, text=True)
+(REPORT / (label + ".source.patch")).write_text(diff)
+command = ["pwsh", "-NoProfile", "-File", str(ROOT / "scripts/qwen38-build.ps1"), "-Jobs", "4"]
+(REPORT / (label + ".build.json")).write_text(json.dumps({"command": command, "variant": args.variant}, indent=2))
+with build_log.open("w") as stream:
+    subprocess.run(command, cwd=ROOT, stdout=stream, stderr=stream, check=True)
+print("Built", args.variant, flush=True)
+if not args.build_only:
+    base = [sys.executable, str(ROOT / "scripts/qwen38_experiment.py"), "--model", MODEL,
+            "--env", "LLAMA_MMAP_TRIM_GPU=1"]
+    subprocess.run(base + ["--label", label], cwd=ROOT, check=True)
+    subprocess.run(base + ["--label", label + "-quality", "--quality-task"], cwd=ROOT, check=True)
+    # Record the strict comparison even when it fails; the variant must then be rejected.
+    comparison = subprocess.run([sys.executable, str(ROOT / "scripts/qwen38_quality_compare.py"),
+                    str(REPORT / "quant-iq4xs-quality/quality.json"),
+                    str(REPORT / (label + "-quality/quality.json"))], cwd=ROOT)
+    subprocess.run([sys.executable, str(ROOT / "scripts/qwen38_ppl.py"), "--label", label + "-ppl",
+                    "--model", MODEL, "--context", "64", "--batch", "3", "--ubatch", "3"], cwd=ROOT, check=True)
+    if comparison.returncode:
+        raise SystemExit("Strict logits gate failed; retain measured rejection and restore/control the next design")
