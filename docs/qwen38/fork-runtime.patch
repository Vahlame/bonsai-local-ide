diff --git a/scripts/qwen38-etw/Program.cs b/scripts/qwen38-etw/Program.cs
new file mode 100644
index 0000000..7790ef7
--- /dev/null
+++ b/scripts/qwen38-etw/Program.cs
@@ -0,0 +1,95 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using Microsoft.Diagnostics.Symbols;
+using Microsoft.Diagnostics.Tracing;
+using Microsoft.Diagnostics.Tracing.Etlx;
+using Microsoft.Diagnostics.Tracing.Parsers.Kernel;
+
+if (args.Length < 2) {
+    Console.Error.WriteLine("usage: qwen38-etw trace.etl output-prefix [after-ms]");
+    return 1;
+}
+double after = args.Length > 2 ? double.Parse(args[2], CultureInfo.InvariantCulture) : 0;
+using var log = TraceLog.OpenOrConvert(args[0]);
+string symbolCache = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Qwen38Symbols");
+string symbolPath = Environment.GetEnvironmentVariable("_NT_SYMBOL_PATH") ??
+    "srv*" + symbolCache + "*https://msdl.microsoft.com/download/symbols";
+if (args.Length > 3) {
+    symbolPath = Path.GetFullPath(args[3]) + ";" + symbolPath;
+}
+using var symbols = new SymbolReader(Console.Error, symbolPath);
+bool memoryOnly = args.Length > 4 && args[4] == "memory";
+foreach (var module in log.ModuleFiles) {
+    if (!memoryOnly && (module.Name.StartsWith("ggml") || module.Name.StartsWith("llama") ||
+        module.Name.StartsWith("ntdll") || module.Name.StartsWith("ntoskrnl") || module.Name.StartsWith("vcruntime"))) {
+        log.CodeAddresses.LookupSymbolsForModule(symbols, module);
+    }
+}
+var counts = new Dictionary<(string Function, string Source), long>();
+var eventNames = new Dictionary<string, long>();
+var sources = new Dictionary<string, string>();
+var hardFaults = new List<object>();
+var faultEvents = new Dictionary<string, long>();
+long timer = 0;
+foreach (var data in log.Events) {
+    string name = data.EventName;
+    if (name.Contains("PMC", StringComparison.OrdinalIgnoreCase) || name.Contains("Collection")) {
+        eventNames[name] = eventNames.GetValueOrDefault(name) + 1;
+        if (sources.Count < 12 && name.Contains("Collection")) {
+            sources[name + sources.Count] = data.ToString();
+        }
+    }
+    if (!data.ProcessName.Equals("llama-server", StringComparison.OrdinalIgnoreCase) || data.TimeStampRelativeMSec < after) {
+        continue;
+    }
+    if (data is MemoryPageFaultTraceData) {
+        faultEvents[name] = faultEvents.GetValueOrDefault(name) + 1;
+    }
+    if (data is MemoryHardFaultTraceData hard) {
+        var process = log.Processes.GetProcess(data.ProcessID, data.TimeStampRelativeMSec);
+        object? virtualAddress = data.PayloadByName("VirtualAddress");
+        var module = virtualAddress == null ? null :
+            process?.LoadedModules.GetModuleContainingAddress(Convert.ToUInt64(virtualAddress), data.TimeStampRelativeMSec);
+        hardFaults.Add(new { time_ms = data.TimeStampRelativeMSec, module = module?.ModuleFile.FilePath,
+                            file_name = hard.FileName, bytes = hard.ByteCount, payload = data.ToString() });
+    }
+    bool pmc = name.Contains("PMCSample", StringComparison.OrdinalIgnoreCase);
+    bool sample = name.Equals("PerfInfo/Sample", StringComparison.OrdinalIgnoreCase);
+    if (!pmc && !sample) {
+        continue;
+    }
+    object? pointer = data.PayloadByName("InstructionPointer");
+    if (pointer == null) {
+        continue;
+    }
+    var address = data is SampledProfileTraceData sampled ? sampled.IntructionPointerCodeAddress() :
+                  data is PMCCounterProfTraceData counter ? counter.IntructionPointerCodeAddress() : data.CallStack()?.CodeAddress;
+    string function = address?.FullMethodName ?? "";
+    if (string.IsNullOrEmpty(function)) {
+        function = address?.ToString() ?? "unknown";
+    }
+    string source = pmc ? Convert.ToString(data.PayloadByName("ProfileSource")) ?? "unknown-pmc" : "timer";
+    counts[(function, source)] = counts.GetValueOrDefault((function, source)) + 1;
+    if (sample) {
+        ++timer;
+    }
+}
+static string Csv(string text) => "\"" + text.Replace("\"", "\"\"") + "\"";
+using (var csv = new StreamWriter(args[1] + ".functions.csv")) {
+    csv.WriteLine("function,source,samples,percent_of_timer_samples");
+    foreach (var item in counts.OrderByDescending(kv => kv.Value)) {
+        double percent = item.Key.Source == "timer" && timer > 0 ? 100.0 * item.Value / timer : 0;
+        csv.WriteLine($"{Csv(item.Key.Function)},{Csv(item.Key.Source)},{item.Value},{percent.ToString("F6", CultureInfo.InvariantCulture)}");
+    }
+}
+File.WriteAllText(args[1] + ".metadata.json", JsonSerializer.Serialize(new {
+    after_ms = after, timer_samples = timer, event_names = eventNames, source_examples = sources,
+    hard_fault_count = hardFaults.Count, hard_faults = hardFaults, page_fault_events = faultEvents,
+    limitation = "PMC sample counts require validated source IDs and sampling intervals before deriving IPC or stall ratios. Timer percentages are exclusive samples across all server threads."
+}, new JsonSerializerOptions { WriteIndented = true }));
+Console.WriteLine($"Timer samples: {timer}; hard faults: {hardFaults.Count}; groups: {counts.Count}");
+return 0;
