new file mode 100644
index 0000000..2ccb471
--- /dev/null
+++ b/scripts/qwen38_fault_summary.py
@@ -0,0 +1,62 @@
+"""Summarize the ETW hard-fault metadata without committing the raw JSON."""
+import argparse
+import collections
+import json
+import pathlib
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--metadata", required=True)
+parser.add_argument("--out", required=True)
+args = parser.parse_args()
+source = pathlib.Path(args.metadata)
+data = json.loads(source.read_text(encoding="utf-8"))
+faults = data.get("hard_faults", [])
+by_file = collections.Counter()
+bytes_by_file = collections.Counter()
+first_last = {}
+by_bucket = collections.Counter()
+model_faults = []
+for fault in faults:
+    name = str(fault.get("file_name") or fault.get("module") or "unknown")
+    base = name.replace("\\", "/").split("/")[-1]
+    by_file[base] += 1
+    try:
+        bytes_by_file[base] += int(str(fault.get("bytes", 0)).replace(",", ""))
+    except ValueError:
+        pass
+    t = float(fault.get("time_ms", 0)) / 1000.0
+    first_last.setdefault(base, [t, t])
+    first_last[base][0] = min(first_last[base][0], t)
+    first_last[base][1] = max(first_last[base][1], t)
+    bucket = "0-10" if t < 10 else "10-30" if t < 30 else "30-60" if t < 60 else "60-120" if t < 120 else "120+"
+    by_bucket[bucket] += 1
+    low = name.lower()
+    if low.endswith(".gguf") or "qwen38" in low and "gguf" in low:
+        model_faults.append(fault)
+summary = {
+    "source": str(source),
+    "after_ms": data.get("after_ms"),
+    "hard_fault_count": data.get("hard_fault_count", len(faults)),
+    "page_fault_events": data.get("page_fault_events", {}),
+    "by_time_bucket": dict(sorted(by_bucket.items())),
+    "top_files": [
+        {"file": name, "count": count, "bytes": bytes_by_file[name],
+         "first_s": round(first_last[name][0], 3), "last_s": round(first_last[name][1], 3)}
+        for name, count in by_file.most_common(20)
+    ],
+    "model_gguf": {
+        "count": len(model_faults),
+        "bytes": sum(int(str(f.get("bytes", 0)).replace(",", "")) for f in model_faults),
+        "first_s": round(min((float(f.get("time_ms", 0)) / 1000.0 for f in model_faults), default=0), 3),
+        "last_s": round(max((float(f.get("time_ms", 0)) / 1000.0 for f in model_faults), default=0), 3),
+    },
+    "pagefile": {
+        "count": by_file.get("pagefile.sys", 0),
+        "bytes": bytes_by_file.get("pagefile.sys", 0),
+    },
+    "limitations": "Hard faults include module loads during startup. The model GGUF count is separated; time buckets are trace-relative, not server-phase labels.",
+}
+out = pathlib.Path(args.out)
+out.write_text(json.dumps(summary, indent=2), encoding="utf-8")
+print(json.dumps({k: summary[k] for k in ("hard_fault_count", "page_fault_events", "by_time_bucket", "model_gguf", "pagefile")}, indent=2))
+print(json.dumps(summary["top_files"][:12], indent=2))
