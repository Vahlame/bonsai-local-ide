@@ -0,0 +1,36 @@
+import argparse
+import json
+import pathlib
+import statistics
+
+parser = argparse.ArgumentParser()
+parser.add_argument("reference", type=pathlib.Path)
+parser.add_argument("candidate", type=pathlib.Path)
+parser.add_argument("--tail", type=int, default=4)
+parser.add_argument("--allow-binary-change", action="store_true")
+args = parser.parse_args()
+reference_manifest = json.loads((args.reference / "manifest.json").read_text())
+candidate_manifest = json.loads((args.candidate / "manifest.json").read_text())
+same_binary = reference_manifest["binary_sha256"] == candidate_manifest["binary_sha256"]
+assert same_binary or args.allow_binary_change
+results = []
+for n in (6000, 12000, 25000):
+    ref = json.loads((args.reference / f"cache-{n}.json").read_text())
+    cur = json.loads((args.candidate / f"cache-{n}.json").read_text())
+    assert ref["prompt_sha256"] == cur["prompt_sha256"]
+    baseline_ms = ref["summary"]["ttft_median_ms"]
+    candidate_ms = cur["summary"]["ttft_median_ms"]
+    result = {"context": n, "reference_ttft_ms": baseline_ms, "candidate_ttft_ms": candidate_ms,
+              "candidate_range_ms": [min(s["ttft_ms"] for s in cur["samples"][1:]), max(s["ttft_ms"] for s in cur["samples"][1:])],
+              "speedup": baseline_ms / candidate_ms, "cache_n": [s["final"]["timings"]["cache_n"] for s in cur["samples"][1:]],
+              "same_output": all(s["content"] == ref["samples"][0]["content"] for s in cur["samples"])}
+    results.append(result)
+report = {"same_binary": same_binary, "tail_tokens": args.tail, "results": results, "checkpoint_mib": 149.626,
+          "passed": all(r["same_output"] and r["speedup"] > 10 and min(r["cache_n"]) == r["context"] - args.tail for r in results),
+          "decision": "retain resident-KV recurrent prefix cache", "next_experiment": "GPU-upload page retirement and native Windows large-page allocations"}
+for label, directory in (("reference", args.reference), ("candidate", args.candidate)):
+    memory = json.loads((directory / "memory.json").read_text())
+    report[label + "_peak_working_set_mib"] = max(s["working_set"] for s in memory) / 1048576
+args.candidate.with_name(args.candidate.name + "-comparison.json").write_text(json.dumps(report, indent=2))
+print(json.dumps(report, indent=2))
+assert report["passed"]
