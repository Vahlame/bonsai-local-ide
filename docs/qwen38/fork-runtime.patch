+"""Small, fixed held-out perplexity comparison, with complete commands and logs."""
+import argparse
+import hashlib
+import json
+import os
+import pathlib
+import re
+import statistics
+import subprocess
+import time
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser()
+parser.add_argument("--label", required=True)
+parser.add_argument("--model", required=True)
+parser.add_argument("--binary", default=r"C:\Users\user\.local\opt\bonsai-inference\build-Qwen38-sm89\bin\llama-perplexity.exe")
+parser.add_argument("--repetitions", type=int, default=3)
+parser.add_argument("--save-logits")
+parser.add_argument("--kl-baseline")
+parser.add_argument("--context", type=int, default=512)
+parser.add_argument("--batch", type=int, default=512)
+parser.add_argument("--ubatch", type=int, default=256)
+parser.add_argument("--env", action="append", default=[])
+args = parser.parse_args()
+out = ROOT / "reports/2026-11-01-qwen38" / args.label
+out.mkdir()
+corpus = out.parent / "quality-corpus.txt"
+binary = pathlib.Path(args.binary)
+command = [str(binary), "-m", args.model, "-f", str(corpus), "--chunks", "3", "-c", str(args.context),
+           "-b", str(args.batch), "-ub", str(args.ubatch), "-t", "16", "-ngl", "27", "-fa", "on",
+           "-ctk", "q8_0", "-ctv", "q8_0", "--fit", "off", "--seed", "42"]
+if args.save_logits:
+    command.extend(["--save-all-logits", args.save_logits])
+if args.kl_baseline:
+    command.extend(["--kl-divergence", "--kl-divergence-base", args.kl_baseline])
+env = os.environ.copy()
+env["LLAMA_MMAP_TRIM_GPU"] = "1"
+for entry in args.env:
+    key, value = entry.split("=", 1)
+    env[key] = value
+report = {"command": command, "env": {"LLAMA_MMAP_TRIM_GPU": "1", **dict(e.split("=", 1) for e in args.env)},
+          "corpus_sha256": hashlib.sha256(corpus.read_bytes()).hexdigest(),
+          "binary_sha256": {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in [binary] + sorted(binary.parent.glob('*.dll'))}, "samples": [],
+          "scored_tokens": 3 * (args.context - args.context // 2 - 1),
+          "small_batch_dot_requested": args.ubatch <= 3,
+          "limitation": "Three fixed project-documentation chunks, not broad language quality. Only ubatch <= 3 exercises the fused small-batch IQ4 dot."}
+for repetition in range(args.repetitions):
+    start = time.perf_counter()
+    with (out / f"run-{repetition}.log").open("w") as log:
+        result = subprocess.run(command, env=env, stdout=log, stderr=log,
+                                creationflags=subprocess.CREATE_NO_WINDOW | subprocess.HIGH_PRIORITY_CLASS)
+    text = (out / f"run-{repetition}.log").read_text(errors="replace")
+    match = re.search(r"Final estimate: PPL = ([0-9.]+) \+/- ([0-9.]+)", text)
+    if args.kl_baseline:
+        match = re.search(r"Mean PPL\(Q\)\s*:\s*([0-9.]+) . ([0-9.]+)", text)
+    if result.returncode or not match:
+        raise RuntimeError(f"Perplexity failed; see {out}")
+    sample = {"repetition": repetition, "ppl": float(match[1]), "uncertainty": float(match[2]),
+              "wall_s": time.perf_counter() - start}
+    if args.kl_baseline:
+        sample["kl_metrics"] = [line for line in text.splitlines() if " : " in line or "     :" in line]
+    report["samples"].append(sample)
+    report["median_ppl"] = statistics.median(s["ppl"] for s in report["samples"])
+    (out / "result.json").write_text(json.dumps(report, indent=2))
+    print(json.dumps(sample), flush=True)
diff --git a/scripts/qwen38_profile_summary.py b/scripts/qwen38_profile_summary.py
new file mode 100644
index 0000000..f32ecef
--- /dev/null
+++ b/scripts/qwen38_profile_summary.py
@@ -0,0 +1,68 @@
+"""Summarize opt-in traces. Scheduler sync spans include profiling overhead."""
+import argparse
+import bisect
+import collections
+import csv
+import json
+import pathlib
+import re
+
+parser = argparse.ArgumentParser()
+parser.add_argument("prefix", type=pathlib.Path)
+parser.add_argument("--after-us", type=int, required=True)
+args = parser.parse_args()
+
+
+def read(suffix):
+    with pathlib.Path(str(args.prefix) + suffix).open(newline="") as stream:
+        return [r for r in csv.DictReader(stream) if r["start_us"].isdigit() and int(r["start_us"]) >= args.after_us]
+
+
+spans = [r for r in read(".scheduler.csv") if r["stage"] == "compute_sync" and r["backend"] == "CPU"]
+starts = [int(r["start_us"]) for r in spans]
+ops = collections.Counter()
+functions = collections.Counter()
+layers = collections.Counter()
+layer_types = collections.Counter()
+barrier = 0
+last_layer = -1
+for row in read(".cpu.csv"):
+    index = bisect.bisect_right(starts, int(row["start_us"])) - 1
+    if index < 0:
+        continue
+    span = spans[index]
+    # MTP target verification has 1-3 columns. Exclude prefill and initialization.
+    if int(span["ne1"]) > 3 or int(row["start_us"]) > starts[index] + int(span["elapsed_us"]):
+        continue
+    match = re.search(r"-(\d+)(?:$| )", row["node"])
+    if match:
+        last_layer = int(match[1])
+    elapsed = int(row["elapsed_us"])
+    ops[(row["op"], row["weight_type"]) ] += elapsed
+    functions[(re.sub(r"-\d+", "-L", row["node"]), row["op"], row["weight_type"]) ] += elapsed
+    layers[last_layer] += elapsed
+    kind = "attention" if last_layer % 4 == 3 else "deltanet"
+    if not 0 <= last_layer < 64:
+        kind = "other"
+    layer_types[kind] += elapsed
+    barrier += int(row["barrier_us"])
+
+
+def table(counter):
+    total = sum(counter.values())
+    return [{"key": key, "seconds": value / 1e6, "percent": value * 100 / total} for key, value in counter.most_common()]
+
+
+sched = collections.Counter()
+for row in read(".scheduler.csv"):
+    if int(row["ne1"]) <= 3:
+        sched[(row["stage"], row["backend"]) ] += int(row["elapsed_us"])
+result = {"after_us": args.after_us, "cpu_operations_decode": table(ops), "cpu_functions_decode": table(functions),
+          "cpu_layers_decode": table(layers), "cpu_layer_types_decode": table(layer_types), "scheduler_decode": table(sched),
+          "coordinator_barrier_seconds": barrier / 1e6,
+          "limitations": ["Layer attribution follows named graph nodes; anonymous nodes inherit the preceding layer.",
+                          "QueryThreadCycleTime measures the coordinator, not all worker cycles.",
+                          "Instructions, IPC, stalls and frequency are NA without hardware counters.",
+                          "Profiling forces backend synchronization; use unprofiled runs for performance decisions."]}
+pathlib.Path(str(args.prefix) + ".summary.json").write_text(json.dumps(result, indent=2), encoding="utf-8")
