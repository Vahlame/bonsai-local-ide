@@ -0,0 +1,67 @@
+"""Two-request cache-budget check against a running server."""
+import json
+import sys
+import urllib.request
+
+BASE = "http://127.0.0.1:8080"
+filler = ("La arquitectura hibrida combina capas DeltaNet y atencion completa. " * 260)
+system = "Eres un asistente breve. " + filler
+tools = [{
+    "type": "function",
+    "function": {
+        "name": "leer",
+        "description": "Lee un archivo",
+        "parameters": {
+            "type": "object",
+            "properties": {"ruta": {"type": "string"}},
+            "required": ["ruta"],
+            "additionalProperties": False,
+        },
+        "strict": True,
+    },
+}]
+a = [
+    {"role": "system", "content": system},
+    {"role": "user", "content": "Responde solo con la palabra OK."},
+]
+b = a + [
+    {"role": "assistant", "content": "", "tool_calls": [{
+        "id": "call_1", "type": "function",
+        "function": {"name": "leer", "arguments": "{\"ruta\":\"x.txt\"}"},
+    }]},
+    {"role": "tool", "tool_call_id": "call_1", "content": "contenido del archivo"},
+    {"role": "user", "content": "Responde solo con la palabra LISTO."},
+]
+
+
+def post(messages):
+    body = {
+        "model": "x", "messages": messages, "stream": False, "cache_prompt": True,
+        "max_tokens": 1, "temperature": 0, "tools": tools, "tool_choice": "auto",
+        "parallel_tool_calls": True,
+    }
+    req = urllib.request.Request(BASE + "/v1/chat/completions", data=json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=300) as response:
+        return json.load(response)
+
+
+def row(name, data):
+    timings = data.get("timings", {})
+    print(json.dumps({
+        "name": name,
+        "cache_n": timings.get("cache_n"),
+        "prompt_n": timings.get("prompt_n"),
+        "prompt_ms": timings.get("prompt_ms"),
+        "content": data.get("choices", [{}])[0].get("message", {}).get("content", "")[:20],
+    }, ensure_ascii=False), flush=True)
+
+
+try:
+    row("first", post(a))
+    row("second", post(b))
+    with urllib.request.urlopen(BASE + "/health", timeout=10) as health:
+        print(json.dumps({"health": json.load(health)}, ensure_ascii=False), flush=True)
+except Exception as exc:
+    print(json.dumps({"error": str(exc)}), flush=True)
+    sys.exit(1)
