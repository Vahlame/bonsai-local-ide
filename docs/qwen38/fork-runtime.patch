@@ -0,0 +1,146 @@
+"""Cancel one managed-IDE turn and verify the next turn still works."""
+import argparse
+import json
+import pathlib
+import subprocess
+import threading
+import time
+import urllib.request
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PROJECT = pathlib.Path(r"C:\Users\user\Documents\prject_local_AI")
+BASE = "http://127.0.0.1:8787"
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--label", required=True)
+parser.add_argument("--mode", choices=("generation", "command"), required=True)
+parser.add_argument("--cancel-after", type=float, default=8.0)
+parser.add_argument("--workspace", default=str(PROJECT / "trabajo/qwen38-cancel"))
+parser.add_argument("--timeout", type=float, default=300)
+args = parser.parse_args()
+OUT = ROOT / "reports/2026-11-01-qwen38" / (args.label + ".json")
+if OUT.exists():
+    raise FileExistsError(OUT)
+WORKSPACE = pathlib.Path(args.workspace).resolve()
+WORKSPACE.mkdir(parents=True, exist_ok=True)
+
+
+def request(path, body=None, timeout=None):
+    data = json.dumps(body).encode() if body is not None else None
+    req = urllib.request.Request(BASE + path, data=data, headers={"Content-Type": "application/json"})
+    return urllib.request.urlopen(req, timeout=timeout or args.timeout)
+
+
+def api(path, body=None):
+    with request(path, body) as response:
+        return json.load(response)
+
+
+def python_pids():
+    try:
+        out = subprocess.check_output(
+            ["powershell.exe", "-NoProfile", "-Command",
+             "Get-CimInstance Win32_Process -Filter \"Name='python.exe'\" | "
+             "Select-Object ProcessId,CommandLine | ConvertTo-Json -Compress"],
+            text=True, timeout=15, stderr=subprocess.DEVNULL)
+        data = json.loads(out) if out.strip() else []
+        return data if isinstance(data, list) else [data]
+    except Exception:
+        return []
+
+
+def run_chat(prompt, events, done, cancel_event, mode=None):
+    start = time.perf_counter()
+    try:
+        with request("/api/chat", {"text": prompt, "modo": mode or ("agente" if args.mode == "command" else "consulta")}) as response:
+            for line in response:
+                elapsed = (time.perf_counter() - start) * 1000
+                if not line.startswith(b"data: "):
+                    continue
+                event = json.loads(line[6:])
+                events.append({"elapsed_ms": elapsed, **event})
+                if event.get("type") in ("action", "speed", "error", "done", "replace", "status"):
+                    print(json.dumps({"elapsed_ms": elapsed, **event}, ensure_ascii=False)[:1200], flush=True)
+                if event.get("type") in ("action", "status") and args.mode == "command":
+                    text = json.dumps(event, ensure_ascii=False)
+                    if "sleep(120)" in text or "sleep(120" in text:
+                        cancel_event.set()
+                if event.get("type") == "done":
+                    break
+    except Exception as exc:
+        events.append({"type": "client_error", "error": str(exc)})
+    finally:
+        done.set()
+
+
+before_chat = api("/api/chats")["active"]
+before_workspace = api("/api/workspace")["root"]
+before_python = python_pids()
+api("/api/workspace", {"path": str(WORKSPACE)})
+active = api("/api/chats", {"op": "new"})["active"]
+prompt = (
+    "Ejecuta exactamente este comando con la herramienta ejecutar y espera a que termine: "
+    'python -c "import time; time.sleep(120)". No hagas nada m├ís.'
+    if args.mode == "command" else
+    "Escribe un texto largo de al menos 1500 palabras sobre la historia de la computaci├│n. "
+    "No uses herramientas, no crees archivos y no termines antes de tiempo."
+)
+report = {
+    "created_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+    "scope": "One managed-IDE cancellation test plus one follow-up request.",
+    "mode": args.mode,
+    "workspace": str(WORKSPACE),
+    "prompt": prompt,
+    "events": [],
+    "before_python": before_python,
+}
+try:
+    events, done, cancel_event = [], threading.Event(), threading.Event()
+    thread = threading.Thread(target=run_chat, args=(prompt, events, done, cancel_event), daemon=True)
+    start = time.perf_counter()
+    thread.start()
+    cancelled = False
+    while time.perf_counter() - start < args.timeout:
+        if cancel_event.wait(0.2):
+            time.sleep(1.0)
+            break
+        if done.is_set():
+            break
+        if args.mode == "generation" and time.perf_counter() - start >= args.cancel_after:
+            break
+    if not done.is_set():
+        api("/api/stop", {})
+        cancelled = True
+    done.wait(30)
+    thread.join(10)
+    report["cancelled"] = cancelled
+    report["events"] = events
+    report["busy_after_stop"] = bool(api("/api/state").get("busy"))
+    report["python_after_stop"] = python_pids()
+    follow = []
+    follow_done = threading.Event()
+    run_chat("Responde solo con la palabra OK. No uses herramientas.", follow, follow_done, threading.Event(), mode="consulta")
+    report["followup_events"] = follow
+    report["followup_text"] = "".join(
+        e.get("text", "") for e in follow if e.get("type") in ("token", "replace")
+    )[-500:]
+    report["passed"] = bool(
+        cancelled
+        and not report["busy_after_stop"]
+        and any(e.get("type") == "done" for e in follow)
+        and "OK" in report["followup_text"].upper()
+    )
+finally:
+    try:
+        api("/api/workspace", {"path": before_workspace})
+        report["previous_workspace_restored"] = True
+    except Exception as exc:
+        report["previous_workspace_restore_error"] = str(exc)
+    if before_chat != active:
+        try:
+            api("/api/chats", {"op": "open", "id": before_chat})
+            report["previous_chat_restored"] = True
+        except Exception as exc:
+            report["previous_chat_restore_error"] = str(exc)
+    OUT.write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding="utf-8")
+print(json.dumps({k: v for k, v in report.items() if k not in ("events", "followup_events")}, ensure_ascii=False), flush=True)
