index 0000000..d0c520c
--- /dev/null
+++ b/scripts/qwen38_experiment.py
@@ -0,0 +1,194 @@
+"""Launch one isolated variant with the fixed reference server configuration."""
+import argparse
+import ctypes
+import hashlib
+import json
+import os
+import pathlib
+import socket
+import subprocess
+import sys
+import threading
+import time
+from ctypes import wintypes
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PROJECT = pathlib.Path(r"C:\Users\user\Documents\prject_local_AI")
+
+
+class MemoryCounters(ctypes.Structure):
+    _fields_ = [("cb", wintypes.DWORD), ("PageFaultCount", wintypes.DWORD)] + [
+        (key, ctypes.c_size_t) for key in ("PeakWorkingSetSize", "WorkingSetSize", "QuotaPeakPagedPoolUsage",
+        "QuotaPagedPoolUsage", "QuotaPeakNonPagedPoolUsage", "QuotaNonPagedPoolUsage", "PagefileUsage",
+        "PeakPagefileUsage", "PrivateUsage")]
+
+
+class MemoryStatus(ctypes.Structure):
+    _fields_ = [("length", wintypes.DWORD), ("load", wintypes.DWORD)] + [
+        (key, ctypes.c_ulonglong) for key in ("total_phys", "avail_phys", "total_pagefile",
+        "avail_pagefile", "total_virtual", "avail_virtual", "avail_extended_virtual")]
+
+
+class GpuMemory(ctypes.Structure):
+    _fields_ = [(key, ctypes.c_ulonglong) for key in ("total", "free", "used")]
+
+
+def monitor(process, samples, stop):
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel.OpenProcess.restype = wintypes.HANDLE
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    psapi = ctypes.WinDLL("psapi", use_last_error=True)
+    psapi.GetProcessMemoryInfo.argtypes = [wintypes.HANDLE, ctypes.POINTER(MemoryCounters), wintypes.DWORD]
+    nvml = None
+    gpu = ctypes.c_void_p()
+    try:
+        nvml = ctypes.WinDLL("nvml.dll")
+        nvml.nvmlInit_v2()
+        if nvml.nvmlDeviceGetHandleByIndex_v2(0, ctypes.byref(gpu)):
+            nvml = None
+    except OSError:
+        pass
+    handle = kernel.OpenProcess(0x410, False, process.pid)
+    try:
+        while not stop.is_set():
+            counters = MemoryCounters()
+            counters.cb = ctypes.sizeof(counters)
+            if handle and psapi.GetProcessMemoryInfo(handle, ctypes.byref(counters), counters.cb):
+                sample = {"monotonic": time.monotonic(), "working_set": counters.WorkingSetSize,
+                          "private": counters.PrivateUsage, "page_faults_total": counters.PageFaultCount}
+                memory = MemoryStatus()
+                memory.length = ctypes.sizeof(memory)
+                if kernel.GlobalMemoryStatusEx(ctypes.byref(memory)):
+                    sample.update(physical_available=memory.avail_phys, memory_load_percent=memory.load)
+                gpu_memory = GpuMemory()
+                if nvml and not nvml.nvmlDeviceGetMemoryInfo(gpu, ctypes.byref(gpu_memory)):
+                    sample.update(gpu_used=gpu_memory.used, gpu_free=gpu_memory.free)
+                samples.append(sample)
+            stop.wait(1)
+    finally:
+        if handle:
+            kernel.CloseHandle(handle)
+        if nvml:
+            nvml.nvmlShutdown()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--label", required=True)
+    parser.add_argument("--binary", default=r"C:\Users\user\.local\opt\bonsai-inference\build-Qwen38-sm89\bin\llama-server.exe")
+    parser.add_argument("--env", action="append", default=[])
+    parser.add_argument("--tokens", type=int, default=96)
+    parser.add_argument("--prompt-tokens", type=int, default=256)
+    parser.add_argument("--cache", action="store_true")
+    parser.add_argument("--quality-only", action="store_true")
+    parser.add_argument("--quality-task", action="store_true")
+    parser.add_argument("--cache-contexts", action="store_true")
+    parser.add_argument("--server-arg", action="append", default=[])
+    parser.add_argument("--allocator-weights", action="store_true")
+    parser.add_argument("--gpu-layers", type=int, default=27)
+    parser.add_argument("--cache-ram", type=int, default=512)
+    parser.add_argument("--draft-max", type=int, default=2)
+    parser.add_argument("--draft-p-min", type=float, default=0.0)
+    parser.add_argument("--priority", choices=("normal", "above", "high"), default="high")
+    parser.add_argument("--real-workloads", action="store_true")
+    parser.add_argument("--model", default=str(PROJECT / "models/qwen38-27b-Qwen3.8-27B-UD-IQ4_XS.gguf"))
+    args = parser.parse_args()
+    try:
+        connection = socket.create_connection(("127.0.0.1", 8080), timeout=1)
+    except OSError:
+        pass
+    else:
+        connection.close()
+        raise RuntimeError("Port 8080 is already occupied; refusing to benchmark another server")
+    out = ROOT / "reports/2026-11-01-qwen38" / args.label
+    out.mkdir()
+    env = os.environ.copy()
+    env.pop("GGML_PERF_CSV", None)
+    for entry in args.env:
+        key, value = entry.split("=", 1)
+        env[key] = value
+    command = [args.binary, "-m", args.model,
+               "-ngl", str(args.gpu_layers), "-c", "32768", "-ctk", "q8_0", "-ctv", "q8_0", "-fa", "on",
+               "-b", "512", "-ub", "256", "-t", "16", "--fit", "off", "--load-mode", "mmap",
+               "--cache-ram", str(args.cache_ram), "--spec-type", "draft-mtp", "--spec-draft-n-max", str(args.draft_max),
+               "--spec-draft-p-min", str(args.draft_p_min), "--parallel", "1", "--jinja", "--metrics",
+               "--no-context-shift", "--ctx-checkpoints", "0", "--no-reasoning-preserve",
+               "--host", "127.0.0.1", "--port", "8080"]
+    command.extend(args.server_arg)
+    if args.allocator_weights:
+        command[command.index("--load-mode") + 1] = "none"
+        command.extend(["--no-host", "--no-repack", "--override-tensor",
+                        r"^blk\.([0-9]|[12][0-9]|3[0-8])\..*=CPU,^token_embd\.weight$=CPU"])
+    manifest = {"command": command, "env": args.env, "priority": args.priority,
+                "commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()}
+    public_perf_prefixes = ("GGML_CPU_", "GGML_CUDA_", "GGML_WIN32_", "GGML_PERF_", "LLAMA_MMAP_")
+    public_perf_keys = {"LLAMA_DEVICE_FROM_PROJECTION", "LLAMA_ARG_CACHE_RECURRENT_PREFIX", "LLAMA_ARG_CACHE_REUSE"}
+    manifest["effective_performance_env"] = {key: value for key, value in env.items()
+        if key.startswith(public_perf_prefixes) or key in public_perf_keys}
+    manifest["source_diff"] = subprocess.check_output(["git", "diff", "HEAD", "--", "ggml", "src", "tools"], cwd=ROOT, text=True)
+    binary_dir = pathlib.Path(args.binary).parent
+    build_record = binary_dir / "qwen38-build.json"
+    if build_record.exists():
+        manifest["build_provenance"] = json.loads(build_record.read_text(encoding="utf-8-sig"))
+    else:
+        manifest["build_provenance_note"] = "Build snapshot predates provenance helper; binary hashes identify the executable code. Working-tree diff may include unbuilt experiments."
+    binary_files = [pathlib.Path(args.binary)] + sorted(binary_dir.glob("*.dll"))
+    manifest["binary_sha256"] = {path.name: hashlib.sha256(path.read_bytes()).hexdigest() for path in binary_files}
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+    stop = threading.Event()
+    samples = []
+    with (out / "stdout.log").open("w") as stdout, (out / "stderr.log").open("w") as stderr:
+        priority = {"normal": subprocess.NORMAL_PRIORITY_CLASS, "above": subprocess.ABOVE_NORMAL_PRIORITY_CLASS,
+                    "high": subprocess.HIGH_PRIORITY_CLASS}[args.priority]
+        process = subprocess.Popen(command, stdout=stdout, stderr=stderr, env=env,
+                                   creationflags=subprocess.CREATE_NO_WINDOW | priority)
+        manifest["server_pid"] = process.pid
+        (out / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+        thread = threading.Thread(target=monitor, args=(process, samples, stop), daemon=True)
+        thread.start()
+        try:
+            import urllib.request
+            deadline = time.monotonic() + 180
+            while True:
+                if process.poll() is not None:
+                    raise RuntimeError(f"Server exited during startup: {process.returncode}; see {out / 'stderr.log'}")
+                try:
+                    with urllib.request.urlopen("http://127.0.0.1:8080/health", timeout=3) as health:
+                        if json.load(health).get("status") == "ok":
+                            break
+                except OSError:
+                    pass
+                if time.monotonic() > deadline:
+                    raise TimeoutError("Server not ready")
+                time.sleep(1)
+            bench = [sys.executable, str(ROOT / "scripts/qwen38-bench.py"), "--label", args.label, "--out", str(out / "benchmark.json"),
+                     "--tokens", str(args.tokens), "--prompt-tokens", str(args.prompt_tokens)]
+            if args.cache:
+                bench.append("--cache")
+            if args.real_workloads:
+                for workload in ("code", "prose"):
+                    subprocess.run([sys.executable, str(ROOT / "scripts/qwen38-bench.py"), "--label", args.label,
+                                    "--out", str(out / f"{workload}.json"), "--workload", workload, "--tokens", str(args.tokens)], check=True)
+            elif args.cache_contexts:
+                for context in (6000, 12000, 25000):
+                    subprocess.run([sys.executable, str(ROOT / "scripts/qwen38-bench.py"), "--label", args.label,
+                                    "--out", str(out / f"cache-{context}.json"), "--prompt-tokens", str(context), "--tokens", "24",
+                                    "--cache", "--salt", f"// Cache scenario {context}\n"], check=True)
+            elif not (args.quality_only or args.quality_task):
+                subprocess.run(bench, check=True)
+            else:
+                quality = [sys.executable, str(ROOT / "scripts/qwen38_quality.py"), "--out", str(out / "quality.json")]
+                if args.quality_task:
+                    quality.append("--task")
+                subprocess.run(quality, check=True)
+        finally:
+            stop.set()
+            thread.join()
+            if process.poll() is None:
+                process.terminate()
+                process.wait(timeout=30)
+            (out / "memory.json").write_text(json.dumps(samples, indent=2), encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
