-        GGML_UNUSED(first);
-        GGML_UNUSED(last);
+        static const bool trim = [] {
+            const char * value = getenv("LLAMA_MMAP_TRIM_GPU");
+            return value && atoi(value) != 0;
+        }();
+        if (!trim || first >= last || first >= size) {
+            return;
+        }
+        SYSTEM_INFO info;
+        GetSystemInfo(&info);
+        const size_t page = info.dwPageSize;
+        last = std::min(last, size) / page * page;
+        if (first > SIZE_MAX - (page - 1)) {
+            return;
+        }
+        first = (first + page - 1) / page * page;
+        if (first >= last) {
+            return;
+        }
+        // An unlocked mapped range is removed from the working set without invalidating its addresses.
+        if (!VirtualUnlock((char *) addr + first, last - first) && GetLastError() != ERROR_NOT_LOCKED) {
+            LLAMA_LOG_WARN("%s: could not retire GPU upload pages: %s\n", __func__, llama_format_win_err(GetLastError()).c_str());
+        } else {
+            LLAMA_LOG_INFO("%s: retired %.3f MiB of GPU upload pages from the working set\n", __func__, (last - first) / 1048576.0);
+        }
     }
 
     ~impl() {
