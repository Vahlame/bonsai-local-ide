+static void ggml_backend_cpu_buffer_free_virtual(ggml_backend_buffer_t buffer) {
+    const std::lock_guard<std::mutex> lock(ggml_win_lock_mutex);
+    const auto found = ggml_win_locked_buffers.find(buffer->context);
+    if (found != ggml_win_locked_buffers.end()) {
+        VirtualUnlock(buffer->context, found->second);
+        ggml_win_locked_bytes -= found->second;
+        ggml_win_locked_buffers.erase(found);
+        SetProcessWorkingSetSize(GetCurrentProcess(), ggml_win_base_minimum + ggml_win_locked_bytes,
+                                ggml_win_base_maximum + ggml_win_locked_bytes);
+    }
+    VirtualFree(buffer->context, 0, MEM_RELEASE);
+}
+
+static void * ggml_backend_cpu_alloc_windows(size_t size) {
+    static const int mode = [] {
+        const char * value = getenv("GGML_WIN32_ALLOCATOR");
+        if (value && strcmp(value, "normal") == 0) { return -1; }
+        if (value && strcmp(value, "large") == 0) { return 1; }
+        if (value && strcmp(value, "lock") == 0) { return 2; }
+        return 0;
+    }();
+    if (!mode) {
+        return nullptr;
+    }
+    if (mode < 0) {
+        fprintf(stderr, "%s: normal CPU allocation requested %zu bytes\n", __func__, size);
+        return nullptr;
+    }
+    const SIZE_T page = GetLargePageMinimum();
+    if (!page || size < page || size > SIZE_MAX - (page - 1)) {
+        return nullptr;
+    }
+    const SIZE_T rounded = (size + page - 1) / page * page;
+    MEMORYSTATUSEX memory = {};
+    memory.dwLength = sizeof(memory);
+    if (GlobalMemoryStatusEx(&memory) &&
+            (memory.ullAvailPhys < rounded || memory.ullAvailPhys - rounded < 512ull * 1024 * 1024)) {
+        GGML_LOG_WARN("%s: insufficient physical headroom for %zu bytes, using pageable memory\n", __func__, rounded);
+        return nullptr;
+    }
+    if (mode == 2) {
+        void * data = VirtualAlloc(nullptr, rounded, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        if (!data) {
+            return nullptr;
+        }
+        const std::lock_guard<std::mutex> lock(ggml_win_lock_mutex);
+        if (ggml_win_locked_buffers.empty()) {
+            GetProcessWorkingSetSize(GetCurrentProcess(), &ggml_win_base_minimum, &ggml_win_base_maximum);
+        }
+        const bool budget_ok = ggml_win_locked_bytes <= SIZE_MAX - rounded &&
+            ggml_win_base_maximum <= SIZE_MAX - ggml_win_locked_bytes - rounded &&
+            ggml_win_base_minimum <= SIZE_MAX - ggml_win_locked_bytes - rounded;
+        if (!budget_ok) {
+            return data;
+        }
+        SetProcessWorkingSetSize(GetCurrentProcess(), ggml_win_base_minimum + ggml_win_locked_bytes + rounded,
+                                ggml_win_base_maximum + ggml_win_locked_bytes + rounded);
+        if (!VirtualLock(data, rounded)) {
+            fprintf(stderr, "%s: VirtualLock failed (%lu), retaining pageable allocation\n", __func__, GetLastError());
+            SetProcessWorkingSetSize(GetCurrentProcess(), ggml_win_base_minimum + ggml_win_locked_bytes,
+                                    ggml_win_base_maximum + ggml_win_locked_bytes);
+        } else {
+            try {
+                ggml_win_locked_buffers.emplace(data, rounded);
+            } catch (const std::bad_alloc &) {
+                VirtualUnlock(data, rounded);
+                SetProcessWorkingSetSize(GetCurrentProcess(), ggml_win_base_minimum + ggml_win_locked_bytes,
+                                        ggml_win_base_maximum + ggml_win_locked_bytes);
+                return data;
+            }
+            ggml_win_locked_bytes += rounded;
+            fprintf(stderr, "%s: VirtualLock secured %zu bytes\n", __func__, rounded);
+        }
+        return data;
+    }
+    static std::mutex privilege_mutex;
+    const std::lock_guard<std::mutex> lock(privilege_mutex);
+    HANDLE token = nullptr;
+    TOKEN_PRIVILEGES requested = {}, previous = {};
+    DWORD previous_size = sizeof(previous);
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token)) {
+        return nullptr;
+    }
+    requested.PrivilegeCount = 1;
+    requested.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    void * data = nullptr;
+    if (LookupPrivilegeValueW(nullptr, L"SeLockMemoryPrivilege", &requested.Privileges[0].Luid)) {
+        SetLastError(ERROR_SUCCESS);
+        const BOOL changed = AdjustTokenPrivileges(token, FALSE, &requested, sizeof(previous), &previous, &previous_size);
+        if (changed && GetLastError() == ERROR_SUCCESS) {
+            data = VirtualAlloc(nullptr, rounded, MEM_RESERVE | MEM_COMMIT | MEM_LARGE_PAGES, PAGE_READWRITE);
+            const DWORD error = GetLastError();
+            AdjustTokenPrivileges(token, FALSE, &previous, 0, nullptr, nullptr);
+            if (data) {
+                fprintf(stderr, "%s: large pages secured %zu bytes (page size %zu)\n", __func__, rounded, page);
+            } else {
+                fprintf(stderr, "%s: large pages failed for %zu bytes (%lu), using pageable memory\n", __func__, rounded, error);
+            }
+        } else {
+            fprintf(stderr, "%s: SeLockMemoryPrivilege unavailable, using pageable memory\n", __func__);
+        }
+    }
+    CloseHandle(token);
+    return data;
+}
