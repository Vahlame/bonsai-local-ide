{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "types": ["node"],
    "typeRoots": ["./chat/node_modules/@types"],
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "chat/rutas-sensibles.mjs",
    "chat/retencion.mjs",
    "chat/red-segura.mjs",
    "chat/server/security-headers.mjs",
    "chat/server/observability.mjs"
  ]
}
